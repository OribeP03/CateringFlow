@model IEnumerable<NotificationModel>
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Notifications";
    ViewData["ActivePage"] = "Notifications";
}

@{
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Notifications</h1>
        <div class="page-header-sub">@unreadCount unread</div>
    </div>
    <div>
        <form asp-action="MarkAllRead" method="post" class="d-inline">
            <button type="submit" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-check2"></i> Mark all as read
            </button>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="notifications-tabs-row">
    <button type="button" class="notif-tab-pill active" onclick="filterNotifs('all', this)">All (@Model.Count())</button>
    <button type="button" class="notif-tab-pill" onclick="filterNotifs('unread', this)">Unread (@unreadCount)</button>
</div>

<div class="notification-list-container">
    @if (!Model.Any())
    {
        <div class="text-center text-muted py-4">No notifications.</div>
    }
    @foreach (var n in Model)
    {
        <div class="notification-row-card @(n.IsRead ? "" : "unread-notif")">
            <div class="flex-grow-1 d-flex gap-3 align-items-center">
                <div style="width: 12px;">
                    @if (!n.IsRead)
                    {
                        <span class="notif-dot-unread">●</span>
                    }
                </div>
                <div>
                    <div class="fw-semibold @(n.IsRead ? "" : "unread-notif-title")">@n.Title</div>
                    <div class="small text-muted">@n.Message</div>
                    <div class="small text-muted d-flex gap-2 mt-1">
                        <span><span class="status-pill @(n.Type == "Warning" ? "low-stock" : n.Type == "Success" ? "completed" : "upcoming")">@n.Type</span></span>
                        <span>· @n.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</span>
                        @if (!string.IsNullOrEmpty(n.TargetRole))
                        {
                            <span>· <i class="bi bi-person-badge"></i> @n.TargetRole</span>
                        }
                    </div>
                </div>
            </div>
            <div class="d-flex gap-1">
                @if (!n.IsRead)
                {
                    <form asp-action="MarkAsRead" asp-route-id="@n.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-success" title="Mark as read"><i class="bi bi-check-lg"></i></button>
                    </form>
                }
                <form asp-action="Delete" asp-route-id="@n.Id" method="post" onsubmit="return confirm('Delete this notification?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterNotifs(type, el) {
            document.querySelectorAll('.notif-tab-pill').forEach(btn => btn.classList.remove('active'));
            el.classList.add('active');
            document.querySelectorAll('.notification-row-card').forEach(card => {
                card.style.display = (type === 'unread' && card.classList.contains('unread-notif')) || type === 'all' ? 'flex' : 'none';
            });
        }
    </script>
}