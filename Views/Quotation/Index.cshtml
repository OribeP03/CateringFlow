@model PagedResult<QuotationModel>
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Quotations";
    ViewData["ActivePage"] = "Quotations";
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Quotations</h1>
        <div class="page-header-sub">@Model.TotalItems total quotations</div>
    </div>
    <div>
        <a asp-action="Create" class="admin-btn-primary">
            <i class="bi bi-plus-lg"></i> + Create Quotation
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<!-- Quotation Status KPI Cards (incremental, largest value on right) -->
@{
    var totalDraft = (ViewData["TotalDraft"] as int?) ?? 0;
    var totalRejected = (ViewData["TotalRejected"] as int?) ?? 0;
    var totalSent = (ViewData["TotalSent"] as int?) ?? 0;
    var totalApproved = (ViewData["TotalApproved"] as int?) ?? 0;
    var totalQuotations = (ViewData["TotalQuotations"] as int?) ?? 0;
    ViewData["KpiGridClass"] = "";
    var quotationCards = new List<KpiCardModel>
    {
        new() { Label = "Draft", Value = @totalDraft.ToString(), SortValue = @totalDraft, ValueFirst = true, FontSize = "1.8rem", Background = "#f8fafc", Foreground = "#6c757d" },
        new() { Label = "Rejected", Value = @totalRejected.ToString(), SortValue = @totalRejected, ValueFirst = true, FontSize = "1.8rem", Background = "#fef2f2", BorderColor = "#fecaca", Foreground = "#dc3545" },
        new() { Label = "Sent", Value = @totalSent.ToString(), SortValue = @totalSent, ValueFirst = true, FontSize = "1.8rem", Background = "#eff6ff", BorderColor = "#bfdbfe", Foreground = "#0d6efd" },
        new() { Label = "Approved", Value = @totalApproved.ToString(), SortValue = @totalApproved, ValueFirst = true, FontSize = "1.8rem", Background = "#ecfdf5", BorderColor = "#a7f3d0", Foreground = "#198754" },
        new() { Label = "Total", Value = @totalQuotations.ToString(), SortValue = @totalQuotations, ValueFirst = true, FontSize = "1.8rem" }
    };
}
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_KpiCards.cshtml", quotationCards)

<form method="get" class="filter-toolbar">
    <div class="filter-search-wrap">
        <i class="bi bi-search"></i>
        <input name="search" type="text" placeholder="Search quotations..." value="@ViewData["Search"]" />
    </div>
    <div class="filter-selects-group">
        <select name="status" class="filter-select">
            <option value="All">All Statuses</option>
            <option value="Approved" selected="@(ViewData["StatusFilter"]?.ToString() == "Approved")">Approved</option>
            <option value="Sent" selected="@(ViewData["StatusFilter"]?.ToString() == "Sent")">Sent</option>
            <option value="Draft" selected="@(ViewData["StatusFilter"]?.ToString() == "Draft")">Draft</option>
            <option value="Rejected" selected="@(ViewData["StatusFilter"]?.ToString() == "Rejected")">Rejected</option>
        </select>
        <button type="submit" class="admin-btn-secondary">Filter</button>
        <a asp-action="Index" class="admin-btn-secondary">Reset</a>
    </div>
</form>

<div class="table-container-card">
    <table class="admin-data-table">
        <thead>
            <tr><th>Number</th><th>Customer</th><th>Pax</th><th>Total</th><th>Status</th><th>Valid Until</th><th>Created</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No quotations found.</td></tr>
            }
            @foreach (var q in Model.Items)
            {
                <tr>
                    <td class="fw-semibold text-primary">@q.QuotationNumber</td>
                    <td>@q.CustomerName</td>
                    <td>@q.PaxCount</td>
                    <td>₱@q.TotalAmount.ToString("N2")</td>
                    <td><span class="status-pill @(q.Status == "Approved" ? "completed" : q.Status == "Rejected" ? "rejected" : q.Status == "Sent" ? "active" : "expiring")">@q.Status</span></td>
                    <td>@(q.ValidUntil?.ToString("MMM dd, yyyy") ?? "—")</td>
                    <td>@q.CreatedAt.ToString("MMM dd, yyyy")</td>
                    <td class="d-flex gap-1">
                        <a asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                        <form asp-action="Delete" asp-route-id="@q.Id" method="post" onsubmit="return confirm('Delete quotation @q.QuotationNumber?');" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("~/Views/SuperAdmin/Components/_Pagination.cshtml", Model)