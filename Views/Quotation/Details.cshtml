@model QuotationModel
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Quotation Details";
    ViewData["ActivePage"] = "Quotations";
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">@Model.QuotationNumber</h1>
        <div class="page-header-sub">@Model.CustomerName · @Model.Status</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="admin-btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<!-- Status Management -->
<div class="widget-card mb-4">
    <h6 class="fw-bold mb-2">Quotation Status</h6>
    <form asp-action="UpdateStatus" method="post" class="d-flex gap-2 align-items-center flex-wrap">
        <input type="hidden" name="id" value="@Model.Id" />
        <select name="status" class="form-select" style="max-width: 200px;">
            <option selected="@(Model.Status == "Draft")">Draft</option>
            <option selected="@(Model.Status == "Sent")">Sent</option>
            <option selected="@(Model.Status == "Approved")">Approved</option>
            <option selected="@(Model.Status == "Rejected")">Rejected</option>
        </select>
        <button type="submit" class="admin-btn-primary"><i class="bi bi-check-lg"></i> Update Status</button>
        <span class="text-muted small">Note: Approving a quotation auto-generates an invoice.</span>
    </form>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="widget-card">
            <h5 class="fw-bold mb-3">Quotation Line Items</h5>
            <div class="mb-2"><i class="bi bi-person me-2"></i><strong>Customer:</strong> @Model.CustomerName</div>
            <div class="mb-2"><i class="bi bi-calendar me-2"></i><strong>Event Date:</strong> @Model.EventDate.ToString("MMMM dd, yyyy")</div>
            <div class="mb-2"><i class="bi bi-people me-2"></i><strong>Pax:</strong> @Model.PaxCount</div>
            <div class="mb-2"><i class="bi bi-journal-bookmark me-2"></i><strong>Package:</strong> @Model.PackageName</div>
            <div class="mb-2"><i class="bi bi-card-text me-2"></i><strong>Event:</strong> @(Model.Event?.EventName ?? "—")</div>
            <hr />
            <table class="table table-sm small mb-0">
                <thead class="table-light">
                    <tr><th>Description</th><th class="text-end">Amount</th></tr>
                    <tr>
                        <td class="ps-0">Catering for @Model.PaxCount pax @(!string.IsNullOrEmpty(Model.PackageName) ? "(" + Model.PackageName + ")" : "")</td>
                        <td class="text-end fw-semibold">₱@Model.TotalAmount.ToString("N2")</td>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <td class="fw-bold">Total</td>
                        <td class="text-end fw-bold text-primary">₱@Model.TotalAmount.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="col-md-6">
        <div class="widget-card">
            <h5 class="fw-bold mb-3">Details</h5>
            <div class="mb-2"><i class="bi bi-calendar2-week me-2"></i><strong>Valid Until:</strong> @(Model.ValidUntil?.ToString("MMMM dd, yyyy") ?? "—")</div>
            <div class="mb-2"><i class="bi bi-clock me-2"></i><strong>Created:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy h:mm tt")</div>
            <hr />
            <div class="small text-muted mb-1"><strong>Notes:</strong></div>
            <div class="small">@(Model.Notes ?? "No notes.")</div>
        </div>
        <div class="widget-card mt-4">
            <h6 class="fw-bold mb-2">Linked Invoice</h6>
            @if (Model.Invoice != null)
            {
                <a asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.Invoice.Id" class="text-decoration-none">
                    <div class="d-flex justify-content-between border rounded p-3">
                        <span class="fw-semibold text-primary">@Model.Invoice.InvoiceNumber</span>
                        <span class="status-pill @(Model.Invoice.Status == "Paid" ? "completed" : "upcoming")">@Model.Invoice.Status</span>
                    </div>
                </a>
            }
            else
            {
                <p class="text-muted small mb-0">No invoice yet. Approve this quotation to auto-generate one.</p>
            }
        </div>
    </div>
</div>