@model IEnumerable<SupplierModel>
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Suppliers";
    ViewData["ActivePage"] = "Suppliers";
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Supplier Management</h1>
        <div class="page-header-sub">@Model.Count() verified vendors</div>
    </div>
    <div>
        <a asp-action="Create" class="admin-btn-primary">
            <i class="bi bi-plus-lg"></i> + Add Supplier
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<form method="get" class="filter-toolbar">
    <div class="filter-search-wrap">
        <i class="bi bi-search"></i>
        <input name="search" type="text" placeholder="Search suppliers..." value="@ViewData["Search"]" />
    </div>
    <div class="filter-selects-group">
        <select name="category" class="filter-select">
            <option value="All">All Categories</option>
            <option value="Meats & Poultry" selected="@(ViewData["CategoryFilter"]?.ToString() == "Meats & Poultry")">Meats & Poultry</option>
            <option value="Seafood" selected="@(ViewData["CategoryFilter"]?.ToString() == "Seafood")">Seafood</option>
            <option value="Produce" selected="@(ViewData["CategoryFilter"]?.ToString() == "Produce")">Produce</option>
            <option value="Grains" selected="@(ViewData["CategoryFilter"]?.ToString() == "Grains")">Grains</option>
        </select>
        <button type="submit" class="admin-btn-secondary">Filter</button>
        <a asp-action="Index" class="admin-btn-secondary">Reset</a>
    </div>
</form>

<div class="table-container-card">
    <table class="admin-data-table">
        <thead>
            <tr><th>Supplier</th><th>Contact Person</th><th>Email</th><th>Phone</th><th>Category</th><th>Items</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No suppliers found.</td></tr>
            }
            @foreach (var s in Model)
            {
                <tr>
                    <td class="fw-semibold text-primary">@s.SupplierName</td>
                    <td>@(s.ContactPerson ?? "—")</td>
                    <td>@(s.Email ?? "—")</td>
                    <td>@(s.Phone ?? "—")</td>
                    <td><span class="status-pill upcoming">@s.Category</span></td>
                    <td>@(s.InventoryItems?.Count ?? 0)</td>
                    <td><span class="status-pill @(s.Status == "Active" ? "completed" : "rejected")">@s.Status</span></td>
                    <td class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Delete supplier @s.SupplierName?');" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>