@model CustomerModel
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Customer Details";
    ViewData["ActivePage"] = "Customers";
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">@Model.FullName</h1>
        <div class="page-header-sub">@Model.Type · @Model.Status · joined @Model.CreatedAt.ToString("MMM dd, yyyy")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="admin-btn-secondary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="admin-btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="widget-card">
            <h5 class="fw-bold mb-3">Contact Information</h5>
            <div class="mb-2"><i class="bi bi-envelope me-2"></i>@Model.Email</div>
            <div class="mb-2"><i class="bi bi-telephone me-2"></i>@(Model.Phone ?? "—")</div>
            <div class="mb-2"><i class="bi bi-geo-alt me-2"></i>@(Model.Address ?? "—")</div>
            <hr />
            <div class="small text-muted mb-1"><strong>Notes:</strong></div>
            <div class="small">@(Model.Notes ?? "No notes.")</div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="widget-card">
            <h5 class="fw-bold mb-3">Events (@(Model.Events?.Count ?? 0))</h5>
            @if (Model.Events != null && Model.Events.Any())
            {
                <table class="admin-data-table">
                    <thead><tr><th>Event</th><th>Type</th><th>Date</th><th>Pax</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.Events.OrderBy(e => e.EventDate))
                        {
                            <tr>
                                <td class="fw-semibold">@e.EventName</td>
                                <td>@e.EventType</td>
                                <td>@e.EventDate.ToString("MMM dd, yyyy")</td>
                                <td>@e.PaxCount</td>
                                <td><span class="status-pill @(e.Status == "Completed" ? "completed" : "upcoming")">@e.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small">No events for this customer yet.</p>
            }
        </div>

        <div class="widget-card mt-4">
            <h6 class="fw-bold mb-2">Quotations: @(Model.Quotations?.Count ?? 0)</h6>
            <h6 class="fw-bold mb-2">Invoices: @(Model.Invoices?.Count ?? 0)</h6>
            <h6 class="fw-bold mb-2">Payments: @(Model.Payments?.Count ?? 0)</h6>
            <h6 class="fw-bold mb-0">CRM Leads: @(Model.CrmLeads?.Count ?? 0)</h6>
        </div>
    </div>
</div>