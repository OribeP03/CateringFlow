@* Views/Client/Components/_GalleryShowcase.cshtml *@
<section id="gallery" class="section-padding bg-white">
    <div class="container text-center">
        <span class="section-tag">Culinary Masterpieces</span>
        <h2 class="section-heading mb-3">Crafted for the senses</h2>
        <p class="section-lead mx-auto">
            A glimpse into the artisan dishes, live buffet stations, and decadent dessert bars crafted by our culinary team.
        </p>

        <div class="gallery-grid text-start">
            <div class="gallery-item">
                <img src="/images/salmon_dish.jpg" alt="Seared Salmon Risotto" />
                <div class="gallery-overlay">
                    <div>
                        <div class="fw-bold">Pan-Seared Atlantic Salmon</div>
                        <small class="text-gold">Plated Course</small>
                    </div>
                </div>
            </div>

            <div class="gallery-item">
                <img src="/images/hero_spread.jpg" alt="Artisanal Meat Medallions" />
                <div class="gallery-overlay">
                    <div>
                        <div class="fw-bold">Prime Beef Tenderloin</div>
                        <small class="text-gold">Signature Entrée</small>
                    </div>
                </div>
            </div>

            <div class="gallery-item">
                <img src="/images/buffet_spread.jpg" alt="Gourmet Carving Station" />
                <div class="gallery-overlay">
                    <div>
                        <div class="fw-bold">Executive Carving Station</div>
                        <small class="text-gold">Live Buffet</small>
                    </div>
                </div>
            </div>

            <div class="gallery-item">
                <img src="/images/dessert_station.jpg" alt="Artisan Dessert Bar" />
                <div class="gallery-overlay">
                    <div>
                        <div class="fw-bold">Parisian Macaron & Tart Bar</div>
                        <small class="text-gold">Dessert Station</small>
                    </div>
                </div>
            </div>

            <div class="gallery-item">
                <img src="/images/event_banner.jpg" alt="Grand Ballroom Table Setting" />
                <div class="gallery-overlay">
                    <div>
                        <div class="fw-bold">Presidential Banquet Setup</div>
                        <small class="text-gold">Full Venue Styling</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
