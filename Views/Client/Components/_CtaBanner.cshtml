@* Views/Client/Components/_CtaBanner.cshtml *@
<section class="cta-banner-section">
    <div class="container">
        <h2 class="cta-banner-title">Ready to streamline your catering business?</h2>
        <p class="cta-banner-sub">
            Whether you are planning your next grand celebration or scaling your catering operations, CateringFlow has the tools to make it extraordinary.
        </p>
        <div class="cta-btn-group">
            <button class="btn btn-light rounded-pill px-4 py-3 fw-bold text-dark shadow-sm" onclick="openBookingModal()">
                <i class="bi bi-calendar-check me-2"></i> Book an Event
            </button>
            <a href="/Account/Login" class="btn btn-outline-light rounded-pill px-4 py-3 fw-bold">
                <i class="bi bi-box-arrow-in-right me-2"></i> Team Sign In
            </a>
        </div>
    </div>
</section>
