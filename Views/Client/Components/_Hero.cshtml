@* Views/Client/Components/_Hero.cshtml *@
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <div class="hero-badge">
                <i class="bi bi-stars"></i> Premium Catering Experience
            </div>
            
            <h1 class="hero-title">
                Every occasion deserves
                <span class="extraordinary">extraordinary food.</span>
            </h1>

            <p class="hero-subtitle">
                Effortless event catering, bespoke tasting menus, and end-to-end hospitality management for weddings, corporate galas, and milestones.
            </p>

            <div class="hero-buttons">
                <button class="btn-luxury-gold btn-large" onclick="openBookingModal()">
                    <i class="bi bi-calendar2-event-fill me-2"></i> Book an Event
                </button>
                <a href="#packages" class="btn-luxury-outline btn-large">
                    <i class="bi bi-journal-text me-2"></i> Explore Packages
                </a>
            </div>

            <div class="hero-stats-row">
                <div class="stat-item">
                    <div class="stat-number">2,500+</div>
                    <div class="stat-label">Events Catered</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">99.2%</div>
                    <div class="stat-label">Happy Clients</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">50+</div>
                    <div class="stat-label">Master Chefs</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">4.9 ★</div>
                    <div class="stat-label">5-Star Reviews</div>
                </div>
            </div>
        </div>
    </div>
</section>
