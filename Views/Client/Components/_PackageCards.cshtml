@using cateringflow.Models
@* Views/Client/Components/_PackageCards.cshtml *@
@{
    var packages = (ViewData["Packages"] as List<MenuPackageModel>) ?? new List<MenuPackageModel>();
}
<section id="packages" class="section-padding packages-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-tag">Curated Menus</span>
            <h2 class="section-heading mb-2">Choose your perfect package</h2>
            <p class="section-lead mx-auto">
                Transparent pricing, premium ingredients, and customizable courses tailored to your guest count.
            </p>
        </div>

        <div class="packages-grid">
            @for (var i = 0; i < packages.Count; i++)
            {
                var pkg = packages[i];
                var featured = pkg.Highlight == "Most Popular" || i == 1;
                var features = (pkg.Features ?? "")
                    .Split('|', StringSplitOptions.RemoveEmptyEntries)
                    .ToList();
                var img = string.IsNullOrWhiteSpace(pkg.ImageName) ? "hero_spread.jpg" : pkg.ImageName;
                <div class="package-card @(featured ? "featured" : "")">
                    <div class="package-img-header">
                        <img src="/images/@img" alt="@pkg.PackageName" />
                        @if (!string.IsNullOrWhiteSpace(pkg.Highlight))
                        {
                            <div class="package-popular-tag">@pkg.Highlight</div>
                        }
                    </div>
                    <div class="package-body">
                        <h3 class="package-title">@pkg.PackageName</h3>
                        <div class="package-subtitle">@pkg.Description</div>

                        <div class="package-price-wrap">
                            <span class="package-price @(featured ? "text-gold" : "")">₱@pkg.PricePerPax.ToString("N0")</span>
                            <span class="package-period">/ guest</span>
                        </div>

                        <ul class="package-features-list">
                            @for (var f = 0; f < features.Count && f < 4; f++)
                            {
                                <li><i class="bi bi-check2-circle"></i> @features[f]</li>
                            }
                            @if (features.Count > 4)
                            {
                                <li class="text-muted fst-italic"><i class="bi bi-plus-circle"></i> +@(features.Count - 4) more inclusions</li>
                            }
                        </ul>

                        <div class="d-flex gap-2 mt-auto">
                            <button class="btn-luxury-outline text-dark border-secondary flex-fill" onclick="openPackageDetails(@i)">
                                <i class="bi bi-eye me-1"></i> View Details
                            </button>
                            <button class="btn-luxury-gold flex-fill" onclick="openBookingModal('@pkg.PackageName')">
                                <i class="bi bi-calendar-check me-1"></i> Book Now
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<script>
    (function () {
        var packages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(packages.Select(p => new
        {
            p.PackageName,
            p.Description,
            price = p.PricePerPax,
            p.CourseCount,
            p.ServiceHours,
            p.Highlight,
            features = (p.Features ?? "").Split('|', StringSplitOptions.RemoveEmptyEntries),
            image = string.IsNullOrWhiteSpace(p.ImageName) ? "hero_spread.jpg" : p.ImageName
        })));
        window.__CATERINGFLOW_PACKAGES__ = packages;
    })();
</script>