@* Views/Client/Components/_BuiltForPros.cshtml *@
<section id="features" class="section-padding features-section">
    <div class="container">
        <div class="row align-items-center mb-5">
            <div class="col-lg-5">
                <span class="section-tag">Enterprise Platform</span>
                <h2 class="section-heading">Built for catering professionals</h2>
                <p class="section-lead">
                    From luxury intimate dinners to 2,000-guest municipal galas, our integrated suite manages your menu tastings, banquet logistics, and kitchen workflows seamlessly.
                </p>
                <a href="/SuperAdmin/Dashboard" class="btn-luxury-gold">
                    Explore Platform <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
            <div class="col-lg-7">
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon-box">
                            <i class="bi bi-card-checklist"></i>
                        </div>
                        <div>
                            <h4 class="feature-title">Smart Menu Planner</h4>
                            <p class="feature-desc">Custom course builders with dietary tag filters, allergen alerts, and live portion calculators.</p>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon-box">
                            <i class="bi bi-kanban"></i>
                        </div>
                        <div>
                            <h4 class="feature-title">Real-time CRM & Leads</h4>
                            <p class="feature-desc">Visual drag-and-drop sales pipeline, auto follow-ups, and quotation generators.</p>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon-box">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div>
                            <h4 class="feature-title">Live Inventory & Stock</h4>
                            <p class="feature-desc">Track perishable ingredients, auto-calculate food costs, and trigger low-stock supplier reorders.</p>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon-box">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <h4 class="feature-title">Staffing & Shift Roster</h4>
                            <p class="feature-desc">Assign executive chefs, sous chefs, banquet captains, and waitstaff with mobile schedule alerts.</p>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon-box">
                            <i class="bi bi-receipt"></i>
                        </div>
                        <div>
                            <h4 class="feature-title">Digital Billing & Payments</h4>
                            <p class="feature-desc">Instant deposit invoices, GCash / Card payment tracking, and automated balance reminders.</p>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon-box">
                            <i class="bi bi-tv"></i>
                        </div>
                        <div>
                            <h4 class="feature-title">Kitchen Display Sync</h4>
                            <p class="feature-desc">Real-time order ticket queues synced directly between event captains and kitchen stations.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
