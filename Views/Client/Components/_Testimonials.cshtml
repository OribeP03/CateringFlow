@* Views/Client/Components/_Testimonials.cshtml *@
<section id="testimonials" class="testimonials-section">
    <div class="container">
        <div class="testimonials-layout">
            <!-- Left Highlight -->
            <div>
                <span class="section-tag">Client Love</span>
                <h2 class="section-heading dark-text mb-4">Loved by our clients</h2>
                <div class="testimonial-featured-quote">
                    “CateringFlow took care of every single detail for our 400-guest wedding at Manila Hotel. The beef tenderloin was perfection and our guests are still raving about the food!”
                </div>
                <div class="client-author-info">
                    <div class="client-avatar">MS</div>
                    <div>
                        <div class="fw-bold text-white fs-5">Maria Santos</div>
                        <div class="text-light-muted">Bride · Santos-Valdez Wedding</div>
                    </div>
                </div>
            </div>

            <!-- Right Reviews Stack -->
            <div class="reviews-stack">
                <div class="review-card-item">
                    <div class="star-rating">
                        <i class="bi bi-star-fill"></i>
