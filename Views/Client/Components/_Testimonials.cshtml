                    <div class="reviewer-meta">
                        <strong class="text-white">Roberto Mendoza</strong> — Solaire Resort Anniversary Gala
                    </div>
                </div>

                <div class="review-card-item">
                    <div class="star-rating">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
