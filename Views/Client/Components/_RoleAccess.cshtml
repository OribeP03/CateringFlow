@* Views/Client/Components/_RoleAccess.cshtml *@
<section class="roles-section">
    <div class="container text-center">
        <span class="section-tag">Enterprise Collaboration</span>
        <h2 class="section-heading mb-3">Role-based access for your whole team</h2>
        <p class="section-lead mx-auto mb-5">
            Every department gets a tailored dashboard with permission-based controls and live operational syncing.
        </p>

        <div class="roles-grid text-start">
            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <div class="role-name">Super Admin</div>
                    <div class="role-desc">Full system & financial oversight</div>
                </div>
            </div>

            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-egg-fried"></i>
                </div>
                <div>
                    <div class="role-name">Kitchen Head</div>
                    <div class="role-desc">Recipe prep & live station queues</div>
                </div>
            </div>

            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-calendar3-event"></i>
                </div>
                <div>
                    <div class="role-name">Event Manager</div>
                    <div class="role-desc">Timelines, venue setups & captaing</div>
                </div>
            </div>

            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <div class="role-name">Staff & Waiters</div>
                    <div class="role-desc">Shift rosters & task assignments</div>
                </div>
            </div>

            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-box2"></i>
                </div>
                <div>
                    <div class="role-name">Inventory Mgr</div>
                    <div class="role-desc">Stock levels & supplier orders</div>
                </div>
            </div>

            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <div class="role-name">Finance & Billing</div>
                    <div class="role-desc">Invoices, GCash & revenue audits</div>
                </div>
            </div>

            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-funnel"></i>
                </div>
                <div>
                    <div class="role-name">CRM & Sales</div>
                    <div class="role-desc">Lead pipeline & proposal generator</div>
                </div>
            </div>

            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-person-circle"></i>
                </div>
                <div>
                    <div class="role-name">Client Portal</div>
                    <div class="role-desc">Menu tasting approvals & tracking</div>
                </div>
            </div>
        </div>
    </div>
</section>
