@* Views/Client/Components/_ProcessSteps.cshtml *@
<section id="process" class="section-padding process-section">
    <div class="container text-center">
        <span class="section-tag">Seamless Experience</span>
        <h2 class="section-heading mb-3">From inquiry to celebration</h2>
        <p class="section-lead mx-auto mb-5">
            We transform catering logistics into a memorable culinary journey with our step-by-step bespoke service.
        </p>

        <div class="process-grid text-start">
            <!-- Step 1 -->
            <div class="process-card">
                <div class="process-img-wrap">
                    <img src="/images/hero_spread.jpg" alt="Choose Package" />
                    <div class="step-num-badge">1</div>
                </div>
                <div class="process-body">
                    <h4>Select Package & Menu</h4>
                    <p>Browse curated multi-course menus or design custom culinary experiences with dietary accommodations.</p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="process-card">
                <div class="process-img-wrap">
                    <img src="/images/salmon_dish.jpg" alt="Tasting and Customization" />
                    <div class="step-num-badge">2</div>
                </div>
                <div class="process-body">
                    <h4>Private Chef Tasting</h4>
                    <p>Sample your selections, adjust flavors and plating styles directly with our executive chefs.</p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="process-card">
                <div class="process-img-wrap">
                    <img src="/images/buffet_spread.jpg" alt="Event Coordination" />
                    <div class="step-num-badge">3</div>
                </div>
                <div class="process-body">
                    <h4>Banquet Logistics Sync</h4>
                    <p>Our event managers coordinate floor plans, linens, chinaware, and precise banquet timelines.</p>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="process-card">
                <div class="process-img-wrap">
                    <img src="/images/dessert_station.jpg" alt="Flawless Execution" />
                    <div class="step-num-badge">4</div>
                </div>
                <div class="process-body">
                    <h4>Flawless Execution</h4>
                    <p>Relax as our uniformed hospitality staff and banquet captains deliver exceptional service.</p>
                </div>
            </div>
        </div>
    </div>
</section>
