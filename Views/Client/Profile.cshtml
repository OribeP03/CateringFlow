@using System.Security.Claims
@using cateringflow.Models
@{
    Layout = null;
    ViewData["Title"] = "My Profile - CateringFlow";
    var customer = Model as CustomerModel;
    var name = User.Identity?.Name ?? "My Account";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? "";
    var role = ViewData["RoleLabel"]?.ToString() ?? "Customer";
    var bookingCount = ViewData["BookingCount"] as int? ?? 0;
    var nameParts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length >= 2
        ? $"{nameParts[0][0]}{nameParts[1][0]}".ToUpperInvariant()
        : name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/client.css" asp-append-version="true" />
</head>
<body>

    @await Html.PartialAsync("~/Views/Client/Components/_Navbar.cshtml")

    <section class="client-section py-5">
        <div class="container">
            <div class="profile-hero py-4">
                <div class="profile-hero-inner">
                    <span class="profile-logo-lg">@initials</span>
                    <div class="profile-hero-text">
                        <h1 class="profile-title">Welcome back, @name.Split(' ')[0]</h1>
                        <p class="profile-subtitle mb-0">
                            <span class="badge profile-role-badge">@role</span>
                            Signed in as <strong>@email</strong>
                        </p>
                    </div>
                    <div class="profile-hero-actions ms-sm-auto mt-3 mt-sm-0">
                        <a href="/Client/MyBookings" class="btn-luxury-gold">
                            <i class="bi bi-calendar-heart me-1"></i> My Caterings (@bookingCount)
                        </a>
                        <button class="btn-luxury-outline" onclick="openBookingModal()">
                            <i class="bi bi-plus-circle me-1"></i> Book an Event
                        </button>
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-1">
                <div class="col-md-7">
                    <div class="client-card">
                        <div class="client-card-header">
                            <i class="bi bi-person-lines-fill me-2"></i> Profile Information
                        </div>
                        <div class="client-card-body">
                            <div class="profile-row">
                                <span class="profile-label">Full Name</span>
                                <span class="profile-value">@name</span>
                            </div>
                            <div class="profile-row">
                                <span class="profile-label">Email Address</span>
                                <span class="profile-value">@email</span>
                            </div>
                            <div class="profile-row">
                                <span class="profile-label">Phone</span>
                                <span class="profile-value">@(customer?.Phone ?? "Add your contact number when you book")</span>
                            </div>
                            <div class="profile-row">
                                <span class="profile-label">Account Type</span>
                                <span class="profile-value">@(customer?.Type ?? "Individual")</span>
                            </div>
                            <div class="profile-row">
                                <span class="profile-label">Member Since</span>
                                <span class="profile-value">@(customer?.CreatedAt.ToString("MMMM d, yyyy") ?? DateTime.Now.ToString("MMMM d, yyyy"))</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="client-card">
                        <div class="client-card-header">
                            <i class="bi bi-stars me-2"></i> Your Catering Journey
                        </div>
                        <div class="client-card-body">
                            <div class="journey-stat">
                                <span class="journey-stat-number">@bookingCount</span>
                                <span class="journey-stat-label">Events Booked</span>
                            </div>
                            <p class="journey-hint mt-3 mb-0">
                                Track your requested caterings, quotations, and event schedules from your
                                <a href="/Client/MyBookings" class="journey-link">My Caterings</a> page.
                            </p>
                            <hr class="my-4" />
                            <a href="/Account/Logout" class="d-inline-flex align-items-center text-danger fw-semibold">
                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @await Html.PartialAsync("~/Views/Client/Components/_BookingModal.cshtml")
    @await Html.PartialAsync("~/Views/Client/Components/_Footer.cshtml")

    <script>
        window.__CATERINGFLOW_AUTH__ = 'true';
    </script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/client.js" asp-append-version="true"></script>
</body>
</html>