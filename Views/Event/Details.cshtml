@model EventModel
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Event Details";
    ViewData["ActivePage"] = "Events";
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">@Model.EventName</h1>
        <div class="page-header-sub">@Model.EventType · @Model.EventDate.ToString("MMMM dd, yyyy") · @Model.Status</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-controller="Event" asp-route-id="@Model.Id" class="admin-btn-secondary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-controller="StaffAssignment" asp-action="Create" class="admin-btn-primary"><i class="bi bi-person-plus"></i> Assign Staff</a>
        <a asp-action="Index" asp-controller="Event" class="admin-btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<!-- Status Update -->
<div class="widget-card mb-4">
    <h6 class="fw-bold mb-2">Update Status</h6>
    <form asp-action="UpdateStatus" asp-controller="Event" method="post" class="d-flex gap-2 align-items-center">
        <input type="hidden" name="id" value="@Model.Id" />
        <select name="status" class="form-select" style="max-width: 200px;">
            <option selected="@(Model.Status == "Upcoming")">Upcoming</option>
            <option selected="@(Model.Status == "In Progress")">In Progress</option>
            <option selected="@(Model.Status == "Completed")">Completed</option>
            <option selected="@(Model.Status == "Cancelled")">Cancelled</option>
        </select>
        <button type="submit" class="admin-btn-primary">Update</button>
    </form>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="widget-card">
            <h5 class="fw-bold mb-3">Event Information</h5>
            <div class="mb-2"><i class="bi bi-person me-2"></i><strong>Customer:</strong> @Model.CustomerName</div>
            <div class="mb-2"><i class="bi bi-tag me-2"></i><strong>Type:</strong> @Model.EventType</div>
            <div class="mb-2"><i class="bi bi-calendar me-2"></i><strong>Date:</strong> @Model.EventDate.ToString("MMMM dd, yyyy")</div>
            <div class="mb-2"><i class="bi bi-geo-alt me-2"></i><strong>Venue:</strong> @(Model.Venue ?? "—")</div>
            <div class="mb-2"><i class="bi bi-people me-2"></i><strong>Pax:</strong> @Model.PaxCount</div>
            <div class="mb-2"><i class="bi bi-journal-bookmark me-2"></i><strong>Package:</strong> @(Model.Package?.PackageName ?? "—")</div>
            <div class="mb-2"><i class="bi bi-cash me-2"></i><strong>Total:</strong> ₱@Model.TotalAmount.ToString("N2")</div>
            <hr />
            <div class="small text-muted mb-1"><strong>Notes:</strong></div>
            <div class="small">@(Model.Notes ?? "No notes.")</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="widget-card">
            <h5 class="fw-bold mb-3">Staff Assigned (@(Model.StaffAssignments?.Count ?? 0))</h5>
            @if (Model.StaffAssignments != null && Model.StaffAssignments.Any())
            {
                <table class="admin-data-table">
                    <thead><tr><th>Staff</th><th>Role</th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.StaffAssignments)
                        {
                            <tr>
                                <td class="fw-semibold">@a.Staff?.FullName</td>
                                <td>@a.RoleAtEvent</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small">No staff assigned yet.</p>
            }
        </div>
        <div class="widget-card mt-4">
            <h5 class="fw-bold mb-3">Invoices (@(Model.Invoices?.Count ?? 0))</h5>
            @if (Model.Invoices != null && Model.Invoices.Any())
            {
                foreach (var inv in Model.Invoices)
                {
                    <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                        <span class="fw-semibold">@inv.InvoiceNumber</span>
                        <span class="text-muted small">₱@inv.TotalAmount.ToString("N2") · <span class="status-pill @(inv.Status == "Paid" ? "completed" : "upcoming")">@inv.Status</span></span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted small">No invoices linked to this event.</p>
            }
        </div>
    </div>
</div>