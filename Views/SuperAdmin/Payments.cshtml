@* Views/SuperAdmin/Payments.cshtml *@
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Payments";
    ViewData["ActivePage"] = "Payments";
}

<!-- Page Header Row -->
<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Payments</h1>
        <div class="page-header-sub">All recorded payment transactions</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportPayments" class="admin-btn-secondary">
            <i class="bi bi-download"></i> Export CSV
        </a>
        <button class="admin-btn-primary" onclick="openAdminModal('recordPaymentModal')">
            <i class="bi bi-credit-card"></i> + Record Payment
        </button>
    </div>
</div>

<!-- 3 KPI Cards (incremental, largest value on right) -->
@{
    ViewData["KpiGridClass"] = "three-cols";
    var paymentCards = new List<KpiCardModel>
    {
        new() { Label = "Total Collected", Value = "₱591,750", SortValue = 591750, SubNote = "<i class=\"bi bi-arrow-up-short\"></i> from 4 transactions", SubNoteClass = "positive" },
        new() { Label = "This Month", Value = "₱591,750", SortValue = 591750, SubNote = "4 payments" },
        new() { Label = "Most Used Method", Value = "Bank Transfer", SortValue = double.MaxValue, FontSize = "1.5rem", SubNote = "2 transactions" }
    };
}
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_KpiCards.cshtml", paymentCards)

<!-- Search & Filter Toolbar -->
<div class="filter-toolbar">
    <div class="fw-bold fs-6">Payment Records</div>
    <div class="filter-search-wrap" style="max-width: 260px;">
        <i class="bi bi-search"></i>
        <input id="tableLiveSearch" type="text" placeholder="Search payments..." />
    </div>
</div>

<!-- Payments Table Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_PaymentsTable.cshtml")

<!-- Record Payment Modal Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_RecordPaymentModal.cshtml")
