@* Views/SuperAdmin/Payments.cshtml *@
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Payments";
    ViewData["ActivePage"] = "Payments";
}

<!-- Page Header Row -->
<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Payments</h1>
        <div class="page-header-sub">All recorded payment transactions</div>
    </div>
    <div>
        <button class="admin-btn-primary" onclick="openAdminModal('recordPaymentModal')">
            <i class="bi bi-plus-lg"></i> + Record Payment
        </button>
    </div>
</div>

<!-- 3 KPI Cards -->
<div class="kpi-cards-grid" style="grid-template-columns: repeat(3, 1fr);">
    <!-- Total Collected -->
    <div class="kpi-card">
        <div class="kpi-title mb-1">Total Collected</div>
        <div class="kpi-value">₱591,750</div>
        <div class="kpi-change positive">
            <i class="bi bi-arrow-up-short"></i> from 4 transactions
        </div>
    </div>

    <!-- This Month -->
    <div class="kpi-card">
        <div class="kpi-title mb-1">This Month</div>
        <div class="kpi-value">₱591,750</div>
        <div class="text-muted small">4 payments</div>
    </div>

    <!-- Most Used Method -->
    <div class="kpi-card">
        <div class="kpi-title mb-1">Most Used Method</div>
        <div class="kpi-value" style="font-size: 1.5rem;">Bank Transfer</div>
        <div class="text-muted small">2 transactions</div>
    </div>
</div>

<!-- Search & Filter Toolbar -->
<div class="filter-toolbar">
    <div class="fw-bold fs-6">Payment Records</div>
    <div class="filter-search-wrap" style="max-width: 260px;">
        <i class="bi bi-search"></i>
        <input id="tableLiveSearch" type="text" placeholder="Search payments..." />
    </div>
</div>

<!-- Payments Table Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_PaymentsTable.cshtml")

<!-- Record Payment Modal Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_RecordPaymentModal.cshtml")
