@* Views/SuperAdmin/Quotations.cshtml *@
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Quotations";
    ViewData["ActivePage"] = "Quotations";
}

<!-- Page Header Row -->
<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Quotations</h1>
        <div class="page-header-sub">6 total quotations</div>
    </div>
    <div>
        <button class="admin-btn-primary" onclick="openAdminModal('createQuotationModal')">
            <i class="bi bi-plus-lg"></i> + Create Quotation
        </button>
    </div>
</div>

<!-- 5 Quotation Status KPI Cards (incremental, largest value on right) -->
@{
    ViewData["KpiGridClass"] = "";
    var quotationCards = new List<KpiCardModel>
    {
        new() { Label = "Draft", Value = "1", SortValue = 1, ValueFirst = true, FontSize = "1.8rem", Background = "#f8fafc", Foreground = "#6c757d" },
        new() { Label = "Rejected", Value = "1", SortValue = 1, ValueFirst = true, FontSize = "1.8rem", Background = "#fef2f2", BorderColor = "#fecaca", Foreground = "#dc3545" },
        new() { Label = "Sent", Value = "2", SortValue = 2, ValueFirst = true, FontSize = "1.8rem", Background = "#eff6ff", BorderColor = "#bfdbfe", Foreground = "#0d6efd" },
        new() { Label = "Approved", Value = "2", SortValue = 2, ValueFirst = true, FontSize = "1.8rem", Background = "#ecfdf5", BorderColor = "#a7f3d0", Foreground = "#198754" },
        new() { Label = "Total", Value = "6", SortValue = 6, ValueFirst = true, FontSize = "1.8rem" }
    };
}
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_KpiCards.cshtml", quotationCards)

<!-- Search & Filter Toolbar -->
<div class="filter-toolbar">
    <div class="filter-search-wrap">
        <i class="bi bi-search"></i>
        <input id="tableLiveSearch" type="text" placeholder="Search quotations..." />
    </div>
    <div class="filter-selects-group">
        <select id="tableStatusFilter" class="filter-select">
            <option value="All">All Statuses</option>
            <option value="Approved">Approved</option>
            <option value="Sent">Sent</option>
            <option value="Draft">Draft</option>
            <option value="Rejected">Rejected</option>
        </select>
    </div>
</div>

<!-- Quotations Table Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_QuotationsTable.cshtml")

<!-- Create Quotation Modal Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_CreateQuotationModal.cshtml")
