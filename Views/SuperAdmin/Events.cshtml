@* Views/SuperAdmin/Events.cshtml *@
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Events & Bookings";
    ViewData["ActivePage"] = "Events";
}

<!-- Page Header Row -->
<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Events & Bookings</h1>
        <div class="page-header-sub">8 total events</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="btn-group">
            <button id="btnListView" class="admin-btn-primary">
                <i class="bi bi-list-ul"></i> List
            </button>
            <button id="btnCalView" class="admin-btn-secondary">
                <i class="bi bi-calendar3"></i> Calendar
            </button>
        </div>
        <button class="admin-btn-primary" onclick="openAdminModal('newEventModal')">
            <i class="bi bi-plus-lg"></i> + New Event
        </button>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="filter-toolbar">
    <div class="filter-search-wrap">
        <i class="bi bi-search"></i>
        <input id="tableLiveSearch" type="text" placeholder="Search events..." />
    </div>

    <div class="filter-selects-group">
        <select id="tableTypeFilter" class="filter-select">
            <option value="All">All Types</option>
            <option value="Wedding">Wedding</option>
            <option value="Corporate">Corporate</option>
            <option value="Birthday">Birthday</option>
            <option value="Anniversary">Anniversary</option>
        </select>

        <select id="tableStatusFilter" class="filter-select">
            <option value="All">All Statuses</option>
            <option value="Upcoming">Upcoming</option>
            <option value="Completed">Completed</option>
            <option value="In Progress">In Progress</option>
        </select>
    </div>
</div>

<!-- Events Table Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_EventsTable.cshtml")

<!-- Events Calendar View Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_EventsCalendar.cshtml")

<!-- New Event Modal Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_NewEventModal.cshtml")
