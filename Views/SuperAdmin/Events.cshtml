@* Views/SuperAdmin/Events.cshtml *@
@model cateringflow.Models.PagedResult<EventModel>
@using cateringflow.Models
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Events & Bookings";
    ViewData["ActivePage"] = "Events";
}

<!-- Page Header Row -->
<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Events & Bookings</h1>
        <div class="page-header-sub">@Model.TotalItems total events</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="admin-btn-primary" onclick="openAdminModal('newEventModal')">
            <i class="bi bi-plus-lg"></i> + New Event
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-x-circle-fill"></i> @TempData["Error"]
    </div>
}

<!-- Filter Toolbar -->
<form method="get" class="filter-toolbar">
    <div class="filter-search-wrap">
        <i class="bi bi-search"></i>
        <input name="search" type="text" placeholder="Search events..." value="@ViewData["Search"]" />
    </div>
    <div class="filter-selects-group">
        <select name="type" class="filter-select">
            <option value="All">All Types</option>
            <option value="Wedding" selected="@(ViewData["TypeFilter"]?.ToString() == "Wedding")">Wedding</option>
            <option value="Corporate" selected="@(ViewData["TypeFilter"]?.ToString() == "Corporate")">Corporate</option>
            <option value="Birthday" selected="@(ViewData["TypeFilter"]?.ToString() == "Birthday")">Birthday</option>
            <option value="Anniversary" selected="@(ViewData["TypeFilter"]?.ToString() == "Anniversary")">Anniversary</option>
            <option value="Other" selected="@(ViewData["TypeFilter"]?.ToString() == "Other")">Other</option>
        </select>
        <select name="status" class="filter-select">
            <option value="All">All Statuses</option>
            <option value="Upcoming" selected="@(ViewData["StatusFilter"]?.ToString() == "Upcoming")">Upcoming</option>
            <option value="In Progress" selected="@(ViewData["StatusFilter"]?.ToString() == "In Progress")">In Progress</option>
            <option value="Completed" selected="@(ViewData["StatusFilter"]?.ToString() == "Completed")">Completed</option>
            <option value="Cancelled" selected="@(ViewData["StatusFilter"]?.ToString() == "Cancelled")">Cancelled</option>
        </select>
        <button type="submit" class="admin-btn-secondary">Filter</button>
        <a href="/SuperAdmin/Events" class="admin-btn-secondary">Reset</a>
    </div>
</form>

<!-- Events Table -->
<div class="table-container-card">
    <table class="admin-data-table">
        <thead>
            <tr>
                <th>Event</th>
                <th>Customer</th>
                <th>Type</th>
                <th>Date</th>
                <th>Venue</th>
                <th>Pax</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-4">No events found.</td></tr>
            }
            @foreach (var e in Model.Items)
            {
                var statusClass = e.Status switch
                {
                    "Completed" => "completed",
                    "In Progress" => "busy",
                    "Cancelled" => "rejected",
                    _ => "upcoming"
                };
                <tr>
                    <td class="fw-semibold">@e.EventName</td>
                    <td>@e.CustomerName</td>
                    <td><span class="status-pill @(e.EventType == "Corporate" ? "upcoming" : e.EventType == "Birthday" ? "expiring" : e.EventType == "Anniversary" ? "available" : "completed")">@e.EventType</span></td>
                    <td>@e.EventDate.ToString("MMM dd, yyyy")</td>
                    <td>@(e.Venue ?? "—")</td>
                    <td>@e.PaxCount</td>
                    <td>₱@e.TotalAmount.ToString("N0")</td>
                    <td><span class="status-pill @statusClass">@e.Status</span></td>
                    <td class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-primary" title="View"
                                data-id="@e.Id" data-name="@e.EventName" data-customer="@e.CustomerName"
                                data-type="@e.EventType" data-date="@e.EventDate.ToString("MMM dd, yyyy")"
                                data-venue="@(e.Venue ?? "")" data-pax="@e.PaxCount"
                                data-package="@(e.Package?.PackageName ?? "No package")"
                                data-amount="@e.TotalAmount.ToString("N0")" data-status="@e.Status"
                                data-notes="@(e.Notes ?? "")"
                                onclick="openViewEventModal(this)">
                            <i class="bi bi-eye"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit"
                                data-id="@e.Id" data-name="@e.EventName" data-customer="@e.CustomerId"
                                data-type="@e.EventType" data-date="@e.EventDate.ToString("yyyy-MM-dd")"
                                data-venue="@(e.Venue ?? "")" data-pax="@e.PaxCount"
                                data-package="@(e.PackageId?.ToString() ?? "")" data-status="@e.Status"
                                data-notes="@(e.Notes ?? "")"
                                onclick="openEditEventModal(this)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <form asp-controller="Event" asp-action="Delete" asp-route-returnUrl="/SuperAdmin/Events"
                              method="post" class="d-inline" onsubmit="return confirm('Delete event @e.EventName?');">
                            <input type="hidden" name="id" value="@e.Id" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("~/Views/SuperAdmin/Components/_Pagination.cshtml", Model)

<!-- Event Modals Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_NewEventModal.cshtml")
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_EventViewEditModals.cshtml")

@section Scripts {
    <script>
        window.openViewEventModal = function (btn) {
            const d = btn.dataset;
            document.getElementById('viewEventName').textContent = d.name;
            document.getElementById('viewEventCustomer').textContent = d.customer;
            document.getElementById('viewEventType').textContent = d.type;
            document.getElementById('viewEventDate').textContent = d.date;
            document.getElementById('viewEventVenue').textContent = d.venue || '—';
            document.getElementById('viewEventPax').textContent = d.pax;
            document.getElementById('viewEventPackage').textContent = d.package;
            document.getElementById('viewEventAmount').textContent = '₱' + d.amount;
            document.getElementById('viewEventStatus').textContent = d.status;
            document.getElementById('viewEventNotes').textContent = d.notes || '—';
            openAdminModal('viewEventModal');
        };

        window.openEditEventModal = function (btn) {
            const d = btn.dataset;
            document.getElementById('editEventId').value = d.id;
            document.getElementById('editEventName').value = d.name;
            document.getElementById('editEventCustomer').value = d.customer;
            document.getElementById('editEventType').value = d.type;
            document.getElementById('editEventDate').value = d.date;
            document.getElementById('editEventVenue').value = d.venue;
            document.getElementById('editEventPax').value = d.pax;
            document.getElementById('editEventPackage').value = d.package;
            document.getElementById('editEventStatus').value = d.status;
            document.getElementById('editEventNotes').value = d.notes;
            openAdminModal('editEventModal');
        };
    </script>
}