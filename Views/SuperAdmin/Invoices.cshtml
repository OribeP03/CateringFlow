@* Views/SuperAdmin/Invoices.cshtml *@
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Invoices";
    ViewData["ActivePage"] = "Invoices";
}

<!-- Page Header Row -->
<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Invoices</h1>
        <div class="page-header-sub">6 total invoices</div>
    </div>
    <div>
        <button class="admin-btn-primary" onclick="openAdminModal('createInvoiceModal')">
            <i class="bi bi-plus-lg"></i> + Create Invoice
        </button>
    </div>
</div>

<!-- 5 Invoice Status KPI Cards (incremental, largest value on right) -->
@{
    ViewData["KpiGridClass"] = "";
    var invoiceCards = new List<KpiCardModel>
    {
        new() { Label = "Partial", Value = "1", SortValue = 1, ValueFirst = true, FontSize = "1.8rem", Background = "#fefce8", BorderColor = "#fef08a", Foreground = "#ca8a04" },
        new() { Label = "Unpaid", Value = "1", SortValue = 1, ValueFirst = true, FontSize = "1.8rem", Background = "#eff6ff", BorderColor = "#bfdbfe", Foreground = "#0d6efd" },
        new() { Label = "Overdue", Value = "1", SortValue = 1, ValueFirst = true, FontSize = "1.8rem", Background = "#fef2f2", BorderColor = "#fecaca", Foreground = "#dc3545" },
        new() { Label = "Paid", Value = "3", SortValue = 3, ValueFirst = true, FontSize = "1.8rem", Background = "#ecfdf5", BorderColor = "#a7f3d0", Foreground = "#198754" },
        new() { Label = "Total", Value = "6", SortValue = 6, ValueFirst = true, FontSize = "1.8rem" }
    };
}
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_KpiCards.cshtml", invoiceCards)

<!-- Overdue Warning Alert Banner -->
<div class="admin-alert-banner">
    <i class="bi bi-exclamation-triangle-fill"></i>
    <span>1 overdue invoice(s) require immediate follow-up.</span>
</div>

<!-- Invoices Table Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_InvoicesTable.cshtml")

<!-- Create Invoice Modal Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_CreateInvoiceModal.cshtml")
