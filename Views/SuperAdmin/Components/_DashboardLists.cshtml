@* Views/SuperAdmin/Components/_DashboardLists.cshtml *@
@model DashboardViewModel
@using cateringflow.Models
@functions {
    static string TimeAgo(DateTime dt)
    {
        var span = DateTime.Now - dt;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} minute{(span.TotalMinutes < 2 ? "" : "s")} ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hour{(span.TotalHours < 2 ? "" : "s")} ago";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays} day{(span.TotalDays < 2 ? "" : "s")} ago";
        return dt.ToString("MMM d, yyyy");
    }
}
<div class="dashboard-widgets-grid">
    <!-- 1. Upcoming Events (live) -->
    <div class="widget-card">
        <div class="widget-header">
            <div class="widget-title-wrap">
                <i class="bi bi-calendar-event text-primary"></i>
                <div class="widget-title">Upcoming Events</div>
            </div>
            <span class="widget-counter">@Model.UpcomingEvents.Count shown</span>
        </div>
        <div class="widget-list">
            @if (Model.UpcomingEvents.Count == 0)
            {
                <div class="text-muted small p-3">No upcoming events scheduled.</div>
            }
            @foreach (var e in Model.UpcomingEvents)
            {
                var icon = e.EventType switch
                {
                    "Wedding" => "bi bi-gift",
                    "Corporate" => "bi bi-building",
                    "Birthday" => "bi bi-balloon-heart",
                    "Anniversary" => "bi bi-heart",
                    _ => "bi bi-calendar-event"
                };
                <div class="widget-list-item">
                    <div class="item-left">
                        <div class="item-icon-box"><i class="@icon"></i></div>
                        <div>
                            <div class="item-title">@e.EventName</div>
                            <div class="item-sub">@e.EventDate.ToString("MMM dd, yyyy") · @e.PaxCount guests</div>
                        </div>
                    </div>
                    <div class="item-right">
                        <div class="item-amount">₱@e.TotalAmount.ToString("N0")</div>
                        <span class="status-pill upcoming">@e.Status</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 2. Recent Payments (live) -->
    <div class="widget-card">
        <div class="widget-header">
            <div class="widget-title-wrap">
                <i class="bi bi-credit-card text-success"></i>
                <div class="widget-title">Recent Payments</div>
            </div>
            <span class="widget-counter">@Model.RecentPayments.Count shown</span>
        </div>
        <div class="widget-list">
            @if (Model.RecentPayments.Count == 0)
            {
                <div class="text-muted small p-3">No payments recorded yet.</div>
            }
            @foreach (var p in Model.RecentPayments)
            {
                <div class="widget-list-item">
                    <div class="item-left">
                        <div class="item-icon-box text-success"><i class="bi bi-check-circle-fill text-success"></i></div>
                        <div>
                            <div class="item-title">@(p.Customer?.FullName ?? "—")</div>
                            <div class="item-sub">@p.PaymentDate.ToString("MMM dd, yyyy") · @p.PaymentMethod</div>
                        </div>
                    </div>
                    <div class="item-right">
                        <div class="item-amount text-success">₱@p.Amount.ToString("N0")</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 3. Stock Alerts (live: at/below reorder level) -->
    <div class="widget-card">
        <div class="widget-header">
            <div class="widget-title-wrap">
                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                <div class="widget-title">Stock Alerts</div>
            </div>
            <span class="widget-counter">@Model.StockAlerts.Count items</span>
        </div>
        <div class="widget-list">
            @if (Model.StockAlerts.Count == 0)
            {
                <div class="text-muted small p-3">All stock levels are adequate.</div>
            }
            @foreach (var i in Model.StockAlerts)
            {
                var stockClass = i.StockStatus == "Out of Stock" ? "out-of-stock" : "low-stock";
                <div class="widget-list-item">
                    <div class="item-left">
                        <div class="item-icon-box"><i class="bi bi-box-seam"></i></div>
                        <div>
                            <div class="item-title">@i.ItemName</div>
                            <div class="item-sub">@i.CurrentStock @i.Unit remaining (reorder @i.MinReorderLevel @i.Unit)</div>
                        </div>
                    </div>
                    <div class="item-right">
                        <span class="status-pill @stockClass">@i.StockStatus</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 4. Recent Activity (live: latest bookings) -->
    <div class="widget-card">
        <div class="widget-header">
            <div class="widget-title-wrap">
                <i class="bi bi-clock-history text-secondary"></i>
                <div class="widget-title">Recent Activity</div>
            </div>
            <span class="widget-counter">@Model.RecentActivity.Count shown</span>
        </div>
        <div class="activity-timeline">
            @if (Model.RecentActivity.Count == 0)
            {
                <div class="text-muted small p-3">No recent activity.</div>
            }
            @foreach (var e in Model.RecentActivity)
            {
                var statusClass = e.Status switch
                {
                    "Completed" => "completed",
                    "In Progress" => "busy",
                    "Cancelled" => "rejected",
                    _ => "upcoming"
                };
                <div class="timeline-entry">
                    <span class="timeline-dot"></span>
                    <div class="timeline-content">
                        <div class="timeline-action">@e.Status booking</div>
                        <div class="timeline-detail">@e.EventName · ₱@e.TotalAmount.ToString("N0") · @e.PaxCount pax</div>
                        <div class="timeline-time">@TimeAgo(e.CreatedAt)</div>
                    </div>
                    <span class="status-pill @statusClass">@e.Status</span>
                </div>
            }
        </div>
    </div>
</div>