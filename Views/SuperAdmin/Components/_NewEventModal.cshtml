@* Views/SuperAdmin/Components/_NewEventModal.cshtml *@
@using cateringflow.Models
<div id="newEventModal" class="admin-modal-backdrop">
    <div class="admin-modal-dialog">
        <div class="admin-modal-header">
            <div>
                <h5 class="admin-modal-title mb-1">Create New Event Booking</h5>
                <p class="text-muted small mb-0">Record a confirmed catering contract into the schedule.</p>
            </div>
            <button type="button" class="admin-modal-close" onclick="closeAdminModal('newEventModal')">&times;</button>
        </div>
        <form asp-controller="Event" asp-action="Create" method="post">
            <input type="hidden" name="returnUrl" value="/SuperAdmin/Events" />
            @Html.AntiForgeryToken()
            <div class="admin-modal-body">
                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Event Name *</label>
                        <input type="text" name="EventName" class="form-control" placeholder="e.g. Ayala Executive Dinner" required />
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Customer *</label>
                        <select name="CustomerId" class="form-select" required>
                            @if (ViewData["Customers"] is List<CustomerModel> customers)
                            {
                                @foreach (var c in customers)
                                {
                                    <option value="@c.Id">@c.FullName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Event Type</label>
                        <select name="EventType" class="form-select">
                            <option value="Wedding">Wedding</option>
                            <option value="Corporate">Corporate</option>
                            <option value="Birthday">Birthday</option>
                            <option value="Anniversary">Anniversary</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Event Date *</label>
                        <input type="date" name="EventDate" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Venue</label>
                        <input type="text" name="Venue" class="form-control" placeholder="e.g. Grand Hyatt Ballroom" />
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Guest Count *</label>
                        <input type="number" name="PaxCount" class="form-control" min="1" placeholder="e.g. 300" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Menu Package</label>
                        <select name="PackageId" class="form-select">
                            <option value="">No package</option>
                            @if (ViewData["Packages"] is List<MenuPackageModel> packages)
                            {
                                @foreach (var p in packages)
                                {
                                    <option value="@p.Id">@p.PackageName (₱@p.PricePerPax.ToString("N0")/pax)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Status</label>
                        <select name="Status" class="form-select">
                            <option value="Upcoming">Upcoming</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-12 form-group-admin">
                        <label>Notes</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                    </div>
                </div>
            </div>
            <div class="admin-modal-footer">
                <button type="button" class="admin-btn-secondary" onclick="closeAdminModal('newEventModal')">Cancel</button>
                <button type="submit" class="admin-btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Save Event
                </button>
            </div>
        </form>
    </div>
</div>