@* Views/SuperAdmin/Components/_CrmKanbanBoard.cshtml *@
@model cateringflow.Models.CrmBoardViewModel

<div class="kanban-board-scroll">
    <div class="kanban-board">
        @foreach (var column in Model.Columns)
        {
            <div class="kanban-column @column.CssClass">
                <div class="kanban-column-header">
                    <div class="column-title-wrap">
                        <span class="column-color-indicator"></span>
                        <span class="column-name">@column.Label</span>
                        <span class="column-count-badge">@column.Count</span>
                    </div>
                    <div class="column-total-val">₱@column.TotalValue.ToString("N0")</div>
                </div>
                <div class="kanban-cards-stack">
                    @if (column.Leads.Count == 0)
                    {
                        <div class="text-center text-muted small py-3">No leads in this stage</div>
                    }
                    @foreach (var lead in column.Leads)
                    {
                        var waiting = CrmBoardViewModel.DaysWaiting(lead, DateTime.Now);
                        <div class="kanban-card">
                            <div class="card-client-name">@lead.LeadName</div>
                            <div class="card-event-badge">@(lead.Company ?? lead.Customer?.FullName ?? "Website Inquiry")</div>
                            <div class="card-date-row">
                                <i class="bi bi-calendar3"></i> @lead.CreatedAt.ToString("MMM dd, yyyy")
                                @if (waiting > 0)
                                {
                                    <span class="ms-2 @(waiting >= 7 ? "text-danger" : "text-muted")">@waiting d waiting</span>
                                }
                            </div>
                            <div class="card-footer">
                                <div class="card-val">₱@lead.EstimatedValue.ToString("N0")</div>
                                @if (!string.IsNullOrWhiteSpace(lead.AssignedTo))
                                {
                                    <div class="card-assignee-avatar" title="@lead.AssignedTo">@lead.AssignedTo</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>