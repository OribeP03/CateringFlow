@* Views/SuperAdmin/Components/_ReportsHub.cshtml *@
@model ReportsViewModel
@using cateringflow.Models
@{
    var statusClass = (string status) => status switch
    {
        "Paid" => "paid",
        "Partially Paid" => "partial",
        "Overdue" => "overdue",
        "Cancelled" => "rejected",
        _ => "upcoming"
    };
}
<div class="reports-hub-grid">
    <!-- 1. Sales Reports -->
    <div class="report-category-card">
        <div class="report-card-header sales">
            <i class="bi bi-graph-up-arrow"></i>
            <span>Top Menu Packages</span>
        </div>
        <div class="report-items-list">
            @if (Model.TopPackages.Count == 0)
            {
                <div class="report-item-desc p-2">No package bookings yet.</div>
            }
            @for (var i = 0; i < Model.TopPackages.Count; i++)
            {
                var p = Model.TopPackages[i];
<div class="report-row">
                <div class="report-row-main">
                    <span class="rank-badge">@(i + 1)</span>
                    <div>
                        <div class="report-item-title">@p.PackageName</div>
                        <div class="report-item-desc">@p.Count @(p.Count == 1 ? "booking" : "bookings")</div>
                    </div>
                </div>
                <div class="report-row-value">₱@p.Revenue.ToString("N0")</div>
            </div>
            }
        </div>
        <div class="report-card-footer">
            <a href="/SuperAdmin/Events">View all events →</a>
            <a href="/SuperAdmin/ActivityLog">Activity log →</a>
        </div>
    </div>

    <!-- 2. Finance Reports -->
    <div class="report-category-card">
        <div class="report-card-header finance">
            <i class="bi bi-wallet2"></i>
            <span>Invoice Status</span>
        </div>
        <div class="report-items-list">
            @if (Model.InvoiceBuckets.Count == 0)
            {
                <div class="report-item-desc p-2">No invoices yet.</div>
            }
            @foreach (var b in Model.InvoiceBuckets)
            {
                <div class="report-row">
                    <div class="report-row-main">
                        <span class="status-pill @statusClass(b.Status)">@b.Status</span>
                        <div class="report-item-desc">@b.Count @(b.Count == 1 ? "invoice" : "invoices")</div>
                    </div>
                    <div class="report-row-value">₱@b.TotalAmount.ToString("N0")</div>
                </div>
            }
        </div>
        <div class="report-card-footer">
            <a href="/Invoices">View invoices →</a>
        </div>
    </div>

    <!-- 3. Inventory Reports -->
    <div class="report-category-card">
        <div class="report-card-header inventory">
            <i class="bi bi-box-seam"></i>
            <span>Payment Methods</span>
        </div>
        <div class="report-items-list">
            @if (Model.PaymentMethods.Count == 0)
            {
                <div class="report-item-desc p-2">No payments recorded yet.</div>
            }
            @foreach (var m in Model.PaymentMethods)
            {
                <div class="report-row">
                    <div class="report-row-main">
                        <span class="method-badge">@m.Method</span>
                        <div class="report-item-desc">@m.Count @(m.Count == 1 ? "transaction" : "transactions")</div>
                    </div>
                    <div class="report-row-value">₱@m.TotalAmount.ToString("N0")</div>
                </div>
            }
        </div>
        <div class="report-card-footer">
            <span class="text-muted small">@Model.LowStockItems item(s) at/below reorder level</span>
            <a href="/SuperAdmin/Inventory">View inventory →</a>
        </div>
    </div>

    <!-- 4. Event Reports -->
    <div class="report-category-card">
        <div class="report-card-header event">
            <i class="bi bi-calendar2-range"></i>
            <span>Event Status</span>
        </div>
        <div class="report-items-list">
            <div class="report-row">
                <div class="report-row-main">
                    <span class="status-pill upcoming">Upcoming</span>
                    <div class="report-item-desc">Scheduled events</div>
                </div>
                <div class="report-row-value">@(Model.TotalEvents - Model.CompletedEvents - Model.CancelledEvents)</div>
            </div>
            <div class="report-row">
                <div class="report-row-main">
                    <span class="status-pill paid">Completed</span>
                    <div class="report-item-desc">Delivered events</div>
                </div>
                <div class="report-row-value">@Model.CompletedEvents</div>
            </div>
            <div class="report-row">
                <div class="report-row-main">
                    <span class="status-pill rejected">Cancelled</span>
                    <div class="report-item-desc">Cancelled bookings</div>
                </div>
                <div class="report-row-value">@Model.CancelledEvents</div>
            </div>
        </div>
        <div class="report-card-footer">
            <a href="/SuperAdmin/Events">View all events →</a>
        </div>
    </div>
</div>