@* Views/SuperAdmin/Components/_DashboardCharts.cshtml *@
<div class="dashboard-charts-row">
    <!-- Monthly Revenue Line Chart -->
    <div class="chart-card">
        <div class="chart-header">
            <div>
                <div class="chart-title">Monthly Revenue</div>
                <div class="chart-subtitle">2025 performance</div>
            </div>
            <span class="chart-tag">This Year</span>
        </div>
        <div class="chart-canvas-wrap">
            <canvas id="monthlyRevenueChart"></canvas>
        </div>
    </div>

    <!-- Events by Type Horizontal Bar Chart -->
    <div class="chart-card">
        <div class="chart-header">
            <div>
                <div class="chart-title">Events by Type</div>
                <div class="chart-subtitle">Distribution</div>
            </div>
        </div>
        <div class="chart-canvas-wrap">
            <canvas id="eventsByTypeChart"></canvas>
        </div>
    </div>
</div>
