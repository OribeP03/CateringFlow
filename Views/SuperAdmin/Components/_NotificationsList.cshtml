@* Views/SuperAdmin/Components/_NotificationsList.cshtml *@
<div class="notifications-stack">
    <!-- 1. New Booking (Unread) -->
    <div class="notification-row-card unread-notif">
        <div class="d-flex align-items-center gap-3">
            <div class="notif-icon-box booking">
                <i class="bi bi-calendar-event"></i>
            </div>
            <div>
                <div class="notif-category-title">
                    <span>New Booking</span>
                    <span class="notif-dot-unread"></span>
                </div>
                <div class="notif-main-text">New booking confirmed: Ana Reyes – Reyes-Cruz Wedding (Oct 5, 2025)</div>
                <div class="notif-timestamp">2 hours ago</div>
            </div>
        </div>
        <div>
            <button class="btn btn-sm btn-link text-muted" title="Mark as read"><i class="bi bi-check2"></i></button>
        </div>
    </div>

    <!-- 2. Quotation Approved (Unread) -->
    <div class="notification-row-card unread-notif">
        <div class="d-flex align-items-center gap-3">
