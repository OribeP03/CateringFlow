@* Views/SuperAdmin/Components/_AddLeadModal.cshtml *@
<div id="addLeadModal" class="admin-modal-backdrop">
    <div class="admin-modal-dialog">
        <div class="admin-modal-header">
            <div>
                <h5 class="admin-modal-title mb-1">Add New CRM Lead</h5>
                <p class="text-muted small mb-0">Record a new prospective catering client into the pipeline.</p>
            </div>
            <button class="admin-modal-close" onclick="closeAdminModal('addLeadModal')">&times;</button>
        </div>
        <form onsubmit="event.preventDefault(); alert('Lead added successfully to pipeline!'); closeAdminModal('addLeadModal');">
            <div class="admin-modal-body">
                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Lead / Contact Name *</label>
                        <input type="text" class="form-control" placeholder="e.g. San Miguel Foundation" required />
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Event Type</label>
                        <select class="form-control">
                            <option value="Wedding">Wedding</option>
                            <option value="Corporate" selected>Corporate</option>
                            <option value="Birthday">Birthday</option>
                            <option value="Anniversary">Anniversary</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Target Date</label>
                        <input type="date" class="form-control" value="2026-05-15" />
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Pipeline Stage</label>
                        <select class="form-control">
                            <option value="New Lead" selected>New Lead</option>
                            <option value="Contacted">Contacted</option>
                            <option value="Qualified">Qualified</option>
                            <option value="Quotation Sent">Quotation Sent</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Estimated Value (₱) *</label>
                        <input type="text" class="form-control" value="₱250,000" required />
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Assignee</label>
                        <select class="form-control">
                            <option value="Carlo">Carlo</option>
                            <option value="Diana" selected>Diana</option>
                            <option value="Admin Rivera">Admin Rivera</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="admin-modal-footer">
                <button type="button" class="admin-btn-secondary" onclick="closeAdminModal('addLeadModal')">Cancel</button>
                <button type="submit" class="admin-btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Add Lead
                </button>
            </div>
        </form>
    </div>
</div>
