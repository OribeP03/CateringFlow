@* Views/SuperAdmin/Components/_InventoryModals.cshtml *@
@using cateringflow.Models

<!-- Add Inventory Item Modal -->
<div id="addInventoryModal" class="admin-modal-backdrop">
    <div class="admin-modal-dialog">
        <div class="admin-modal-header">
            <div>
                <h5 class="admin-modal-title mb-1">Add Inventory Item</h5>
                <p class="text-muted small mb-0">Stock status updates automatically from reorder level.</p>
            </div>
            <button type="button" class="admin-modal-close" onclick="closeAdminModal('addInventoryModal')">&times;</button>
        </div>
        <form asp-controller="Inventory" asp-action="Create" method="post">
            <input type="hidden" name="returnUrl" value="/SuperAdmin/Inventory" />
            @Html.AntiForgeryToken()
            <div class="admin-modal-body">
                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Item Code *</label>
                        <input type="text" name="ItemCode" class="form-control" value="@(ViewData["SuggestedCode"])" required />
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Item Name *</label>
                        <input type="text" name="ItemName" class="form-control" placeholder="e.g. Fresh Ribeye" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Category *</label>
                        <select name="Category" class="form-select" required>
                            <option value="Meats & Poultry">Meats & Poultry</option>
                            <option value="Seafood">Seafood</option>
                            <option value="Produce">Produce</option>
                            <option value="Grains">Grains</option>
                            <option value="Beverages">Beverages</option>
                            <option value="Hardware & Linens">Hardware & Linens</option>
                        </select>
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Supplier</label>
                        <select name="SupplierId" class="form-select">
                            <option value="">—</option>
                            @if (ViewData["Suppliers"] is List<SupplierModel> suppliers)
                            {
                                @foreach (var s in suppliers)
                                {
                                    <option value="@s.Id">@s.SupplierName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group-admin">
                        <label>Current Stock *</label>
                        <input type="number" name="CurrentStock" class="form-control" min="0" value="0" required />
                    </div>
                    <div class="col-md-4 form-group-admin">
                        <label>Min Reorder Level *</label>
                        <input type="number" name="MinReorderLevel" class="form-control" min="0" value="10" required />
                    </div>
                    <div class="col-md-4 form-group-admin">
                        <label>Unit</label>
                        <select name="Unit" class="form-select">
                            <option value="kg">kg</option>
                            <option value="pcs">pcs</option>
                            <option value="box">box</option>
                            <option value="liter">liter</option>
                        </select>
                    </div>
                </div>

                <div class="form-group-admin">
                    <label>Unit Cost *</label>
                    <input type="number" name="UnitCost" class="form-control" min="0" step="0.01" value="0" required />
                </div>
            </div>
            <div class="admin-modal-footer">
                <button type="button" class="admin-btn-secondary" onclick="closeAdminModal('addInventoryModal')">Cancel</button>
                <button type="submit" class="admin-btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Save Item
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Inventory Item Modal -->
<div id="editInventoryModal" class="admin-modal-backdrop">
    <div class="admin-modal-dialog">
        <div class="admin-modal-header">
            <div>
                <h5 class="admin-modal-title mb-1">Edit Inventory Item</h5>
                <p class="text-muted small mb-0">Adjust stock levels; status recalculates on save.</p>
            </div>
            <button type="button" class="admin-modal-close" onclick="closeAdminModal('editInventoryModal')">&times;</button>
        </div>
        <form asp-controller="Inventory" asp-action="Edit" method="post">
            <input type="hidden" name="returnUrl" value="/SuperAdmin/Inventory" />
            <input type="hidden" name="id" id="editInventoryId" />
            <input type="hidden" name="Id" id="editInventoryId2" />
            @Html.AntiForgeryToken()
            <div class="admin-modal-body">
                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Item Code *</label>
                        <input type="text" name="ItemCode" id="editInventoryCode" class="form-control" required />
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Item Name *</label>
                        <input type="text" name="ItemName" id="editInventoryName" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Category *</label>
                        <select name="Category" id="editInventoryCategory" class="form-select" required>
                            <option value="Meats & Poultry">Meats & Poultry</option>
                            <option value="Seafood">Seafood</option>
                            <option value="Produce">Produce</option>
                            <option value="Grains">Grains</option>
                            <option value="Beverages">Beverages</option>
                            <option value="Hardware & Linens">Hardware & Linens</option>
                        </select>
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Supplier</label>
                        <select name="SupplierId" id="editInventorySupplier" class="form-select">
                            <option value="">—</option>
                            @if (ViewData["Suppliers"] is List<SupplierModel> suppliers2)
                            {
                                @foreach (var s in suppliers2)
                                {
                                    <option value="@s.Id">@s.SupplierName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group-admin">
                        <label>Current Stock *</label>
                        <input type="number" name="CurrentStock" id="editInventoryStock" class="form-control" min="0" required />
                    </div>
                    <div class="col-md-4 form-group-admin">
                        <label>Min Reorder Level *</label>
                        <input type="number" name="MinReorderLevel" id="editInventoryReorder" class="form-control" min="0" required />
                    </div>
                    <div class="col-md-4 form-group-admin">
                        <label>Unit</label>
                        <select name="Unit" id="editInventoryUnit" class="form-select">
                            <option value="kg">kg</option>
                            <option value="pcs">pcs</option>
                            <option value="box">box</option>
                            <option value="liter">liter</option>
                        </select>
                    </div>
                </div>

                <div class="form-group-admin">
                    <label>Unit Cost *</label>
                    <input type="number" name="UnitCost" id="editInventoryCost" class="form-control" min="0" step="0.01" required />
                </div>
            </div>
            <div class="admin-modal-footer">
                <button type="button" class="admin-btn-secondary" onclick="closeAdminModal('editInventoryModal')">Cancel</button>
                <button type="submit" class="admin-btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>