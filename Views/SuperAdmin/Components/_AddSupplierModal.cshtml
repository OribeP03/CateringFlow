@* Views/SuperAdmin/Components/_AddSupplierModal.cshtml *@
<div id="newSupplierModal" class="admin-modal-backdrop">
    <div class="admin-modal-dialog">
        <div class="admin-modal-header">
            <div>
                <h5 class="admin-modal-title mb-1">Add New Supplier</h5>
                <p class="text-muted small mb-0">Register a vendor partner for ingredient sourcing.</p>
            </div>
            <button type="button" class="admin-modal-close" onclick="closeAdminModal('newSupplierModal')">&times;</button>
        </div>
        <form asp-controller="Supplier" asp-action="Create" method="post">
            <input type="hidden" name="returnUrl" value="/SuperAdmin/Suppliers" />
            @Html.AntiForgeryToken()
            <div class="admin-modal-body">
                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Supplier Name *</label>
                        <input type="text" name="SupplierName" class="form-control" placeholder="e.g. S&R Fresh Market" required />
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Category *</label>
                        <select name="Category" class="form-select" required>
                            <option value="Meats & Poultry">Meats & Poultry</option>
                            <option value="Seafood">Seafood</option>
                            <option value="Produce">Produce</option>
                            <option value="Grains">Grains</option>
                            <option value="Beverages">Beverages</option>
                            <option value="Hardware & Linens">Hardware & Linens</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-admin">
                        <label>Contact Person</label>
                        <input type="text" name="ContactPerson" class="form-control" placeholder="e.g. Maria Santos" />
                    </div>
                    <div class="col-md-6 form-group-admin">
                        <label>Phone</label>
                        <input type="text" name="Phone" class="form-control" placeholder="e.g. 0917 555 1234" />
                    </div>
                </div>

                <div class="form-group-admin">
                    <label>Email Address *</label>
                    <input type="email" name="Email" class="form-control" placeholder="accounts@supplier.ph" required />
                </div>

                <div class="form-group-admin">
                    <label>Address</label>
                    <input type="text" name="Address" class="form-control" placeholder="Unit, Building, Street, City" />
                </div>

                <div class="form-group-admin">
                    <label>Status</label>
                    <select name="Status" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="admin-modal-footer">
                <button type="button" class="admin-btn-secondary" onclick="closeAdminModal('newSupplierModal')">Cancel</button>
                <button type="submit" class="admin-btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Save Supplier
                </button>
            </div>
        </form>
    </div>
</div>