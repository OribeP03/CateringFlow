        <div>Mon</div>
        <div>Tue</div>
        <div>Wed</div>
        <div>Thu</div>
        <div>Fri</div>
        <div>Sat</div>
    </div>

    <div class="calendar-days-grid">
        <!-- Week 1 -->
        <div class="calendar-day-cell other-month"><div class="calendar-day-number">31</div></div>
        <div class="calendar-day-cell"><div class="calendar-day-number">1</div></div>
        <div class="calendar-day-cell"><div class="calendar-day-number">2</div></div>
