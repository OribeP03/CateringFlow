@* Views/SuperAdmin/Dashboard.cshtml *@
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<!-- Page Header -->
<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Good morning, Admin 👋</h1>
        <div class="page-header-sub">Here's what's happening with your catering business today.</div>
    </div>
    <div>
        <a href="/SuperAdmin/Events" class="admin-btn-primary">
            <i class="bi bi-calendar2-plus"></i> View Schedule
        </a>
    </div>
</div>

<!-- 1. KPI Metrics Cards Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_DashboardKpiCards.cshtml")

<!-- 2. Charts Row Component (Line & Bar) -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_DashboardCharts.cshtml")

<!-- 3. Dashboard 4-Grid Lists Component (Upcoming, Payments, Stock Alerts, Activity) -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_DashboardLists.cshtml")
