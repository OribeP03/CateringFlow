@* Views/SuperAdmin/Inventory.cshtml *@
@model cateringflow.Models.PagedResult<InventoryModel>
@using cateringflow.Models
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Inventory & Stock";
    ViewData["ActivePage"] = "Inventory";
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Kitchen Inventory & Stock</h1>
        <div class="page-header-sub">@Model.TotalItems tracked items</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportInventory" asp-route-category="@ViewData["CategoryFilter"]" asp-route-stockStatus="@ViewData["StockStatusFilter"]" class="admin-btn-secondary">
            <i class="bi bi-download"></i> Export CSV
        </a>
        <button class="admin-btn-primary" onclick="openAdminModal('addInventoryModal')">
            <i class="bi bi-plus-lg"></i> + Add Item
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-x-circle-fill"></i> @TempData["Error"]
    </div>
}

<!-- Filter Toolbar -->
<form method="get" class="filter-toolbar">
    <div class="filter-search-wrap">
        <i class="bi bi-search"></i>
        <input name="search" type="text" placeholder="Search items..." value="@ViewData["Search"]" />
    </div>
    <div class="filter-selects-group">
        <select name="category" class="filter-select">
            <option value="All">All Categories</option>
            <option value="Meats & Poultry" selected="@(ViewData["CategoryFilter"]?.ToString() == "Meats & Poultry")">Meats & Poultry</option>
            <option value="Seafood" selected="@(ViewData["CategoryFilter"]?.ToString() == "Seafood")">Seafood</option>
            <option value="Produce" selected="@(ViewData["CategoryFilter"]?.ToString() == "Produce")">Produce</option>
            <option value="Grains" selected="@(ViewData["CategoryFilter"]?.ToString() == "Grains")">Grains</option>
            <option value="Beverages" selected="@(ViewData["CategoryFilter"]?.ToString() == "Beverages")">Beverages</option>
            <option value="Hardware & Linens" selected="@(ViewData["CategoryFilter"]?.ToString() == "Hardware & Linens")">Hardware & Linens</option>
        </select>
        <select name="stockStatus" class="filter-select">
            <option value="All">All Stock Status</option>
            <option value="Adequate" selected="@(ViewData["StockStatusFilter"]?.ToString() == "Adequate")">Adequate</option>
            <option value="Low Stock" selected="@(ViewData["StockStatusFilter"]?.ToString() == "Low Stock")">Low Stock</option>
            <option value="Out of Stock" selected="@(ViewData["StockStatusFilter"]?.ToString() == "Out of Stock")">Out of Stock</option>
        </select>
        <button type="submit" class="admin-btn-secondary">Filter</button>
        <a href="/SuperAdmin/Inventory" class="admin-btn-secondary">Reset</a>
    </div>
</form>

<div class="table-container-card">
    <table class="admin-data-table">
        <thead>
            <tr>
                <th>Item Code</th>
                <th>Item Name</th>
                <th>Category</th>
                <th>Current Stock</th>
                <th>Min Reorder</th>
                <th>Unit Cost</th>
                <th>Supplier</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-4">No inventory items found.</td></tr>
            }
            @foreach (var i in Model.Items)
            {
                var stockClass = i.StockStatus switch
                {
                    "Adequate" => "completed",
                    "Low Stock" => "low-stock",
                    _ => "out-of-stock"
                };
                <tr>
                    <td class="fw-semibold text-primary">@i.ItemCode</td>
                    <td class="fw-semibold">@i.ItemName</td>
                    <td>@i.Category</td>
                    <td>@i.CurrentStock @i.Unit</td>
                    <td>@i.MinReorderLevel @i.Unit</td>
                    <td>₱@i.UnitCost.ToString("N0")</td>
                    <td>@i.SupplierName</td>
                    <td><span class="status-pill @stockClass">@i.StockStatus</span></td>
                    <td class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit"
                                data-id="@i.Id" data-code="@i.ItemCode" data-name="@i.ItemName"
                                data-category="@i.Category" data-stock="@i.CurrentStock"
                                data-reorder="@i.MinReorderLevel"
                                data-unit="@i.Unit" data-cost="@i.UnitCost" data-supplier="@(i.SupplierId?.ToString() ?? "")"
                                onclick="openEditInventoryModal(this)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <form asp-controller="Inventory" asp-action="Delete" asp-route-returnUrl="/SuperAdmin/Inventory"
                              method="post" class="d-inline" onsubmit="return confirm('Delete item @i.ItemName?');">
                            <input type="hidden" name="id" value="@i.Id" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("~/Views/SuperAdmin/Components/_Pagination.cshtml", Model)

<!-- Inventory Modals Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_InventoryModals.cshtml")

@section Scripts {
    <script>
        window.openEditInventoryModal = function (btn) {
            const d = btn.dataset;
            document.getElementById('editInventoryId').value = d.id;
            document.getElementById('editInventoryCode').value = d.code;
            document.getElementById('editInventoryName').value = d.name;
            document.getElementById('editInventoryCategory').value = d.category;
            document.getElementById('editInventoryStock').value = d.stock;
            document.getElementById('editInventoryReorder').value = d.reorder;
            document.getElementById('editInventoryUnit').value = d.unit;
            document.getElementById('editInventoryCost').value = d.cost;
            document.getElementById('editInventorySupplier').value = d.supplier;
            openAdminModal('editInventoryModal');
        };
    </script>
}