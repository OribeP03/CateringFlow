@* Views/SuperAdmin/Staff.cshtml *@
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Staff Management";
    ViewData["ActivePage"] = "Staff";
}

<!-- Page Header Row -->
<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Staff Management</h1>
        <div class="page-header-sub">8 team members</div>
    </div>
    <div>
        <button class="admin-btn-primary" onclick="openAdminModal('addStaffModal')">
            <i class="bi bi-plus-lg"></i> + Add Staff
        </button>
    </div>
</div>

<!-- 4 Staff Status KPI Cards (incremental, largest value on right) -->
@{
    ViewData["KpiGridClass"] = "four-cols";
    var staffCards = new List<KpiCardModel>
    {
        new() { Label = "Busy", Value = "1", SortValue = 1, ValueFirst = true, LabelClass = "fw-semibold small", FontSize = "2rem", Background = "#fffbeb", BorderColor = "#fde68a", Foreground = "#d97706" },
        new() { Label = "On Leave", Value = "1", SortValue = 1, ValueFirst = true, LabelClass = "fw-semibold small", FontSize = "2rem", Background = "#fdf4ff", BorderColor = "#f5d0fe", Foreground = "#a855f7" },
        new() { Label = "Available", Value = "6", SortValue = 6, ValueFirst = true, LabelClass = "fw-semibold small", FontSize = "2rem", Background = "#f0fdf4", BorderColor = "#bbf7d0", Foreground = "#198754" },
        new() { Label = "Full-time", Value = "6", SortValue = 6, ValueFirst = true, LabelClass = "fw-semibold small", FontSize = "2rem", Background = "#fffdf5", BorderColor = "#fef08a", Foreground = "#ca8a04" }
    };
}
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_KpiCards.cshtml", staffCards)

<!-- Search Toolbar -->
<div class="filter-toolbar">
    <div class="filter-search-wrap">
        <i class="bi bi-search"></i>
        <input id="tableLiveSearch" type="text" placeholder="Search staff..." />
    </div>
    <div class="filter-selects-group">
        <select id="tableStatusFilter" class="filter-select">
            <option value="All">All Availability</option>
            <option value="Available">Available</option>
            <option value="Busy">Busy</option>
            <option value="On Leave">On Leave</option>
        </select>
        <select id="tableTypeFilter" class="filter-select">
            <option value="All">All Employment</option>
            <option value="Full-time">Full-time</option>
            <option value="Part-time">Part-time</option>
            <option value="Contractual">Contractual</option>
        </select>
    </div>
</div>

<!-- Staff Table Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_StaffTable.cshtml")

<!-- Add Staff Modal Component -->
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_AddStaffModal.cshtml")
