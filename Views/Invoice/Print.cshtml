@* Views/Invoice/Print.cshtml *@
@model InvoiceModel
@using cateringflow.Models
@{
    Layout = null;
    ViewData["Title"] = $"Print {Model.InvoiceNumber}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.InvoiceNumber — CateringFlow</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; color: #1b1f27; background: #f4f1ea; padding: 40px; }
        .print-toolbar { max-width: 820px; margin: 0 auto 24px; display: flex; gap: 10px; }
        .print-toolbar button, .print-toolbar a {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 10px 18px; border-radius: 8px; border: 1px solid #ddd;
            background: #fff; color: #1b1f27; font-size: 14px; cursor: pointer;
            text-decoration: none;
        }
        .print-toolbar .primary { background: #b87333; border-color: #b87333; color: #fff; }
        .invoice-sheet { background: #fff; max-width: 820px; margin: 0 auto; padding: 48px 56px; border-radius: 12px; box-shadow: 0 2px 14px rgba(27,31,39,.08); }
        .sheet-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #b87333; padding-bottom: 20px; margin-bottom: 24px; }
        .brand h1 { font-size: 26px; color: #b87333; letter-spacing: .5px; }
        .brand .tag { font-size: 12px; color: #7a756c; letter-spacing: 2px; text-transform: uppercase; }
        .doc-title { text-align: right; }
        .doc-title .inv-no { font-size: 20px; font-weight: 700; }
        .doc-title .stamp { display: inline-block; margin-top: 8px; font-size: 12px; padding: 4px 12px; border-radius: 999px; }
        .stamp.paid { background: #e7f6ec; color: #1e8e3e; }
        .stamp.partial { background: #fff4e0; color: #b26a00; }
        .stamp.unpaid { background: #fdeaea; color: #c5221f; }
        .stamp.overdue { background: #fdeaea; color: #c5221f; }
        .billing-row { display: flex; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
        .billing-col { width: 50%; }
        .billing-col h3 { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #7a756c; margin-bottom: 8px; }
        .billing-col .party { font-size: 15px; font-weight: 600; margin-bottom: 2px; }
        .billing-col .muted { font-size: 13px; color: #6b6862; }
        table.items { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        table.items th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #7a756c; border-bottom: 2px solid #e7e3da; padding: 8px 10px; }
        table.items td { padding: 10px; border-bottom: 1px solid #f0ece3; font-size: 14px; }
        .totals { margin-left: auto; width: 320px; }
        .totals .trow { display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; }
        .totals .grand { border-top: 2px solid #e7e3da; margin-top: 6px; padding-top: 12px; font-weight: 700; font-size: 17px; display: flex; justify-content: space-between; }
        .totals .grand .amount { color: #b87333; }
        .notes { margin-top: 28px; padding-top: 16px; border-top: 1px dashed #ddd; font-size: 13px; color: #6b6862; }
        .footer { margin-top: 32px; text-align: center; font-size: 12px; color: #9a968e; }
        .footer strong { color: #6b6862; }
        @@media print {
            body { background: #fff; padding: 0; }
            .print-toolbar { display: none !important; }
            .invoice-sheet { box-shadow: none; border-radius: 0; max-width: 100%; padding: 24px 16px; }
        }
    </style>
</head>
<body>
    <div class="print-toolbar">
        <button class="primary" onclick="window.print()"><i class="bi bi-printer"></i> Print / Save as PDF</button>
        <a asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i> Back to Invoice</a>
    </div>

    <div class="invoice-sheet">
        <div class="sheet-header">
            <div class="brand">
                <h1>CateringFlow</h1>
                <div class="tag">Premium Catering · Events &amp; Cuisine</div>
            </div>
            <div class="doc-title">
                <div class="inv-no">@Model.InvoiceNumber</div>
                <div>Issue Date: @Model.IssueDate.ToString("MMMM dd, yyyy")</div>
                <div>Due Date: @Model.DueDate.ToString("MMMM dd, yyyy")</div>
                <span class="stamp @Model.Status.ToLower().Replace(" ", string.Empty)">@Model.Status</span>
            </div>
        </div>

        <div class="billing-row">
            <div class="billing-col">
                <h3>Billed To</h3>
                <div class="party">@Model.CustomerName</div>
                <div class="muted">@(Model.Customer?.Address ?? "—")</div>
                <div class="muted">@(Model.Customer?.Phone ?? "—")</div>
                <div class="muted">@(Model.Customer?.Email ?? "—")</div>
            </div>
            <div class="billing-col">
                <h3>Event Details</h3>
                @if (Model.Event != null)
                {
                    <div class="party">@Model.Event.EventName</div>
                    <div class="muted">@Model.Event.EventType · @Model.Event.PaxCount pax</div>
                    <div class="muted">@Model.Event.EventDate.ToString("MMMM dd, yyyy")</div>
                    <div class="muted">@(Model.Event.Venue ?? "Venue TBD")</div>
                }
                else
                {
                    <div class="muted">—</div>
                }
            </div>
        </div>

        <table class="items">
            <thead>
                <tr><th style="width:55%;">Description</th><th style="width:45%;">Reference</th><th style="width:20%; text-align:right;">Amount</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-semibold">Catering Service Package</td>
                    <td>@(Model.Quotation?.QuotationNumber ?? "Direct Invoice")</td>
                    <td style="text-align:right;">₱@Model.TotalAmount.ToString("N2")</td>
                </tr>
                @if (Model.Quotation?.Notes != null)
                {
                    <tr><td colspan="3" class="muted">Notes: @Model.Quotation.Notes</td></tr>
                }
            </tbody>
        </table>

        <div class="totals">
            <div class="trow"><div>Total Amount</div><div>₱@Model.TotalAmount.ToString("N2")</div></div>
            <div class="trow"><div>Amount Paid</div><div>₱@Model.AmountPaid.ToString("N2")</div></div>
            <div class="grand"><div>Balance Due</div><div class="amount">₱@Model.Balance.ToString("N2")</div></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="notes"><strong>Notes:</strong> @Model.Notes</div>
        }
        else
        {
            <div class="notes"><strong>Notes:</strong> Thank you for choosing CateringFlow. Payment is due on or before the due date above.</div>
        }

        <div class="footer">
            This is a computer-generated invoice from <strong>CateringFlow</strong>. For questions, contact our events team.
        </div>
    </div>
</body>
</html>