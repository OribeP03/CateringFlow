@model InvoiceModel
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Create Invoice";
    ViewData["ActivePage"] = "Invoices";
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Create Invoice</h1>
        <div class="page-header-sub">Generate a billing invoice</div>
    </div>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="widget-card" style="max-width: 760px;">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="InvoiceNumber" class="form-label">Invoice Number</label>
                <input asp-for="InvoiceNumber" class="form-control" value="@ViewData["SuggestedNumber"]" />
                <span asp-validation-for="InvoiceNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="QuotationId" class="form-label">From Approved Quotation</label>
                <select asp-for="QuotationId" class="form-select">
                    <option value="">-- Manual Invoice --</option>
                    @if (ViewData["Quotations"] is List<QuotationModel> quotations)
                    {
                        foreach (var q in quotations)
                        {
                            <option value="@q.Id">@q.QuotationNumber — @q.CustomerName (₱@q.TotalAmount.ToString("N0"))</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="CustomerId" class="form-label">Customer</label>
                <select asp-for="CustomerId" asp-items="@(new SelectList(ViewData["Customers"] as List<CustomerModel>, "Id", "FullName"))" class="form-select">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EventId" class="form-label">Related Event (optional)</label>
                <select asp-for="EventId" class="form-select">
                    <option value="">-- No Event --</option>
                    @if (ViewData["Events"] is List<EventModel> events)
                    {
                        foreach (var e in events)
                        {
                            <option value="@e.Id">@e.EventName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="TotalAmount" class="form-label">Total Amount</label>
                <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="TotalAmount" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="AmountPaid" class="form-label">Amount Paid</label>
                <input asp-for="AmountPaid" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label">Status (auto-computed)</label>
                <input asp-for="Status" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label asp-for="IssueDate" class="form-label">Issue Date</label>
                <input asp-for="IssueDate" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label asp-for="DueDate" class="form-label">Due Date</label>
                <input asp-for="DueDate" class="form-control" type="date" />
            </div>
            <div class="col-md-12">
                <label asp-for="Notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-12 d-flex gap-2">
                <button type="submit" class="admin-btn-primary"><i class="bi bi-check-lg"></i> Create Invoice</button>
                <a asp-action="Index" class="admin-btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
</form>