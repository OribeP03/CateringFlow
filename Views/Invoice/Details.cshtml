@model InvoiceModel
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Invoice Details";
    ViewData["ActivePage"] = "Invoices";
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">@Model.InvoiceNumber</h1>
        <div class="page-header-sub">@Model.CustomerName · @Model.Status</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Payment" asp-action="Create" asp-route-invoiceId="@Model.Id" class="admin-btn-primary"><i class="bi bi-credit-card"></i> Record Payment</a>
        <a asp-action="Index" class="admin-btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="widget-card mb-4">
    <h6 class="fw-bold mb-2">Update Status</h6>
    <form asp-action="UpdateStatus" method="post" class="d-flex gap-2 align-items-center flex-wrap">
        <input type="hidden" name="id" value="@Model.Id" />
        <select name="status" class="form-select" style="max-width: 200px;">
            <option selected="@(Model.Status == "Unpaid")">Unpaid</option>
            <option selected="@(Model.Status == "Partial")">Partial</option>
            <option selected="@(Model.Status == "Paid")">Paid</option>
            <option selected="@(Model.Status == "Overdue")">Overdue</option>
        </select>
        <button type="submit" class="admin-btn-primary"><i class="bi bi-check-lg"></i> Update</button>
        <span class="text-muted small">Setting to "Paid" auto-fills the amount paid.</span>
    </form>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="widget-card">
            <h5 class="fw-bold mb-3">Invoice Summary</h5>
            <div class="mb-2"><i class="bi bi-person me-2"></i><strong>Customer:</strong> @Model.CustomerName</div>
            <div class="mb-2"><i class="bi bi-receipt me-2"></i><strong>Quotation:</strong> @(Model.Quotation?.QuotationNumber ?? "—")</div>
            <div class="mb-2"><i class="bi bi-calendar-event me-2"></i><strong>Event:</strong> @(Model.Event?.EventName ?? "—")</div>
            <div class="mb-2"><i class="bi bi-calendar me-2"></i><strong>Issue Date:</strong> @Model.IssueDate.ToString("MMMM dd, yyyy")</div>
            <div class="mb-2"><i class="bi bi-calendar-x me-2"></i><strong>Due Date:</strong> @Model.DueDate.ToString("MMMM dd, yyyy")</div>
            <hr />
            <table class="table table-sm small mb-0">
                <tbody>
                    <tr class="table-light"><td class="fw-semibold">Total Amount</td><td class="text-end">₱@Model.TotalAmount.ToString("N2")</td></tr>
                    <tr class="table-light"><td class="fw-semibold">Amount Paid</td><td class="text-end">₱@Model.AmountPaid.ToString("N2")</td></tr>
                    <tr><td class="fw-bold">Balance</td><td class="text-end fw-bold text-primary">₱@Model.Balance.ToString("N2")</td></tr>
                </tbody>
            </table>
            <hr />
            <div class="small text-muted mb-1"><strong>Notes:</strong></div>
            <div class="small">@(Model.Notes ?? "No notes.")</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="widget-card">
            <h5 class="fw-bold mb-3">Payment History (@(Model.Payments?.Count ?? 0))</h5>
            @if (Model.Payments != null && Model.Payments.Any())
            {
                <table class="admin-data-table">
                    <thead><tr><th>Date</th><th>Method</th><th>Ref #</th><th>Amount</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payments.OrderByDescending(p => p.PaymentDate))
                        {
                            <tr>
                                <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                <td>@p.PaymentMethod</td>
                                <td>@(p.ReferenceNumber ?? "—")</td>
                                <td class="fw-semibold">₱@p.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small">No payments recorded yet.</p>
            }
        </div>
    </div>
</div>