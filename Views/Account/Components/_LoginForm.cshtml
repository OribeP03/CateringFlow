@using cateringflow.Services
@{
    var fbSettings = ViewData["FirebaseSettings"] as FirebaseSettings;
}
<div class="login-left-pane">
    <div class="login-top-bar">
        <a href="/" class="back-home-link">
            <i class="bi bi-arrow-left"></i> Back to home
        </a>
    </div>

    <div class="login-form-container">
        @if (fbSettings != null && !fbSettings.IsConfigured)
        {
            <div class="firebase-warning mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Firebase is not configured yet. Ask your admin to add the <code>Firebase</code>
                section in <code>appsettings.json</code> and the service account file to enable sign-in.
            </div>
        }

        <!-- Logo -->
        <div class="login-brand-icon">
            <img src="/images/logo.svg" alt="CateringFlow" class="login-logo-img" />
        </div>

        <!-- Heading -->
        <h1 class="login-title">Welcome back</h1>
        <p class="login-subtitle">Sign in with Google or use your email and password.</p>

        <!-- Error / Info Alert -->
        <div id="loginAlert" class="login-alert" style="display: none;"></div>

        <!-- Google Sign-In -->
        <button type="button" id="googleSignInBtn" class="btn-google-signin" onclick="handleGoogleSignIn()">
            <span class="google-g" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 48 48">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
            </span>
            Continue with Google
        </button>

        <!-- Divider -->
        <div class="divider-with-text"><span>or continue with email</span></div>

        <!-- Email / Password Form -->
        <form id="loginForm" method="post" action="/Account/Login" class="mt-2" onsubmit="handleEmailPasswordLogin(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <!-- Email Input -->
            <div class="form-group-custom mb-3">
                <label for="emailInput">Email address</label>
                <div class="input-wrap">
                    <input type="email" id="emailInput" name="email" class="form-control-custom" placeholder="name@company.com" />
                </div>
            </div>

            <!-- Password Input with Eye Toggle -->
            <div class="form-group-custom mb-2">
                <label for="passwordInput">Password</label>
                <div class="input-wrap password-wrap">
                    <input type="password" id="passwordInput" name="password" class="form-control-custom" placeholder="Password" />
                    <button type="button" class="btn-password-toggle" onclick="togglePasswordVisibility()" title="Toggle password visibility">
                        <i id="passwordEyeIcon" class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <!-- Forgot Password -->
            <div class="text-end mb-4">
                <a href="#" class="forgot-pass-link" onclick="forgotPassword(); return false;">Forgot password?</a>
            </div>

            <!-- Sign In Button -->
            <button type="submit" id="signInSubmitBtn" class="btn-signin-submit">
                Sign In <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </form>

        <!-- Version Tag -->
        <div class="login-version-tag">
            CateringFlow ERP + CRM · v2.0
        </div>
    </div>
</div>