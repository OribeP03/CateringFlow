@* Views/Account/Components/_LoginHeroRight.cshtml *@
<div class="login-right-pane">
    <div class="login-hero-overlay">
        <!-- Top Platform Badge -->
        <div class="platform-badge-pill">
            <span class="badge-dot"></span>
            <span>CateringFlow Platform</span>
        </div>

        <!-- Center Quote & Testimonial -->
        <div class="login-quote-wrap">
            <blockquote class="login-quote-text">
                “CateringFlow transformed how we manage our catering business. Everything is now beautifully organized.”
            </blockquote>

            <div class="login-reviewer-card">
                <div class="reviewer-avatar">AR</div>
                <div>
                    <div class="reviewer-name">Admin Rivera</div>
                    <div class="reviewer-title">Operations Manager</div>
                </div>
            </div>
        </div>

        <!-- Bottom Stats Bar -->
        <div class="login-stats-strip">
            <div class="login-stat-col">
                <div class="stat-big">2,400+</div>
                <div class="stat-small">Events</div>
            </div>
            <div class="login-stat-col">
                <div class="stat-big">500+</div>
                <div class="stat-small">Businesses</div>
            </div>
            <div class="login-stat-col">
                <div class="stat-big">98%</div>
                <div class="stat-small">Satisfaction</div>
            </div>
        </div>
    </div>
</div>
