@model PagedResult<PaymentModel>
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Payments";
    ViewData["ActivePage"] = "Payments";
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">Payments</h1>
        <div class="page-header-sub">All recorded payment transactions</div>
    </div>
    <div>
        <a asp-action="Create" class="admin-btn-primary">
            <i class="bi bi-plus-lg"></i> + Record Payment
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<!-- 3 KPI Cards (incremental, largest value on right) -->
@{
    ViewData["KpiGridClass"] = "three-cols";
    var totalCollected = (ViewData["TotalCollected"] as decimal?) ?? 0m;
    var thisMonth = (ViewData["ThisMonth"] as decimal?) ?? 0m;
    var paymentCount = (ViewData["PaymentCount"] as int?) ?? 0;
    var thisMonthCount = (ViewData["ThisMonthCount"] as int?) ?? 0;
    var paymentCards = new List<KpiCardModel>
    {
        new() { Label = "Total Collected", Value = $"₱{totalCollected:N0}", SortValue = (double)totalCollected, SubNote = "<i class=\"bi bi-arrow-up-short\"></i> from " + @paymentCount + " transactions", SubNoteClass = "positive" },
        new() { Label = "This Month", Value = $"₱{thisMonth:N0}", SortValue = (double)thisMonth, SubNote = @thisMonthCount + " payments" },
        new() { Label = "Most Used Method", Value = (ViewData["MostUsedMethod"]?.ToString() ?? "—"), SortValue = double.MaxValue, FontSize = "1.5rem", SubNote = (ViewData["MostUsedMethodCount"]?.ToString() ?? "0") + " transactions" }
    };
}
@await Html.PartialAsync("~/Views/SuperAdmin/Components/_KpiCards.cshtml", paymentCards)

<div class="table-container-card mt-4">
    <table class="admin-data-table">
        <thead>
            <tr><th>Invoice</th><th>Customer</th><th>Date</th><th>Method</th><th>Ref #</th><th>Amount</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No payments recorded.</td></tr>
            }
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td class="fw-semibold text-primary">@p.InvoiceNumber</td>
                    <td>@(p.Customer?.FullName ?? "—")</td>
                    <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                    <td><span class="status-pill upcoming">@p.PaymentMethod</span></td>
                    <td>@(p.ReferenceNumber ?? "—")</td>
                    <td class="fw-semibold">₱@p.Amount.ToString("N2")</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Delete this payment? Invoice balance will be adjusted.');" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("~/Views/SuperAdmin/Components/_Pagination.cshtml", Model)