@model StaffModel
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Staff Details";
    ViewData["ActivePage"] = "Staff";
}

<div class="page-header-row">
    <div>
        <h1 class="page-header-title">@Model.FullName</h1>
        <div class="page-header-sub">@Model.Position · @Model.Availability · hired @Model.DateHired.ToString("MMM dd, yyyy")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="admin-btn-secondary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="admin-btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="widget-card">
            <h5 class="fw-bold mb-3">Details</h5>
            <div class="mb-2"><i class="bi bi-envelope me-2"></i>@Model.Email</div>
            <div class="mb-2"><i class="bi bi-telephone me-2"></i>@(Model.Phone ?? "—")</div>
            <div class="mb-2"><i class="bi bi-briefcase me-2"></i>@Model.Position</div>
            <div class="mb-2"><i class="bi bi-tag me-2"></i>@Model.EmploymentType</div>
            <div class="mb-2"><i class="bi bi-star me-2"></i>@(Model.Specialty ?? "—")</div>
            <div class="mb-2"><i class="bi bi-calendar-check me-2"></i>@Model.DateHired.ToString("MMMM dd, yyyy")</div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="widget-card">
            <h5 class="fw-bold mb-3">Assigned Events (@(Model.Assignments?.Count ?? 0))</h5>
            @if (Model.Assignments != null && Model.Assignments.Any())
            {
                <table class="admin-data-table">
                    <thead><tr><th>Event</th><th>Role</th><th>Event Date</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.Assignments.OrderBy(a => a.Event?.EventDate))
                        {
                            <tr>
                                <td class="fw-semibold">@a.Event?.EventName</td>
                                <td>@a.RoleAtEvent</td>
                                <td>@a.Event?.EventDate.ToString("MMM dd, yyyy")</td>
                                <td><span class="status-pill upcoming">@a.Event?.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small">No event assignments yet.</p>
            }
        </div>
    </div>
</div>